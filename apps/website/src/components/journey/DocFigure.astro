---
/*
  One screenshot, framed the same way every time: a thin dark mat the width of
  the text column, the picture filling it, then a caption. Captures come in
  many sizes and two themes; the mat is what makes them read as one set, and
  its hairline gives a dark capture an edge on the dark page.

  The picture sets the height. A wide strip stays a strip, and a tall capture
  stops at a ceiling and centres rather than running off the screen.

  `src` is a file name under docs/screenshots/generated/, content/media/web/ or
  docs/screenshots/. Alt text comes from content/media/manifest.json when it
  describes that file, or from `alt`. A missing file or missing alt fails the
  build.

  `recapture` marks a still that is a dark live capture standing in until a
  light one exists. It changes nothing on screen; it is there to be grepped.
*/
import manifest from '../../../../../content/media/manifest.json';

interface Props {
  src: string;
  caption: string;
  alt?: string;
  recapture?: boolean;
}

const { src, caption, alt: altOverride, recapture = false } = Astro.props;

const stills = {
  ...import.meta.glob<{ default: ImageMetadata }>('../../../../../docs/screenshots/generated/*.png', {
    eager: true,
  }),
  ...import.meta.glob<{ default: ImageMetadata }>('../../../../../content/media/web/*.png', {
    eager: true,
  }),
  ...import.meta.glob<{ default: ImageMetadata }>('../../../../../docs/screenshots/*.png', {
    eager: true,
  }),
  ...import.meta.glob<{ default: ImageMetadata }>('../../../public/canvas/*.png', {
    eager: true,
  }),
};

const match = Object.entries(stills).find(([key]) => key.endsWith(`/${src}`));
if (!match) {
  throw new Error(`DocFigure: no still named "${src}" in docs/screenshots/generated/, content/media/web/, docs/screenshots/ or public/canvas/.`);
}
const image = match[1].default;

const described = (manifest.features as Array<{ alt?: Record<string, string | undefined> }>)
  .flatMap((feature) => Object.entries(feature.alt ?? {}))
  .find(([path]) => path.split('/').pop() === src)?.[1];
const alt = altOverride ?? described;
if (!alt) {
  throw new Error(`DocFigure: "${src}" has no alt text in the media manifest. Pass alt=.`);
}
---

<figure class="dfig not-content" data-recapture={recapture ? 'light' : undefined}>
  <div class="dfig__frame">
    <img
      class="dfig__img"
      src={image.src}
      width={image.width}
      height={image.height}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption class="dfig__caption">{caption}</figcaption>
</figure>

<style>
  .dfig {
    margin: var(--space-20) 0 var(--space-24);
  }

  .dfig__frame {
    display: flex;
    justify-content: center;
    padding: var(--space-6);
    background: var(--panel);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
  }

  /* Qualified past docs.css, which gives every content image its own border,
     background and height ceiling. */
  .dfig .dfig__frame img.dfig__img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 40rem;
    margin: 0;
    background: none;
    border: 0;
    border-radius: calc(var(--radius-md) - var(--space-6));
  }

  .dfig__caption {
    margin-top: var(--space-8);
    font-size: var(--fs-ui-sm);
    line-height: var(--lh-ui);
    color: var(--text-muted);
  }
</style>
