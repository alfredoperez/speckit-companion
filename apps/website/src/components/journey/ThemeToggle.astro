---
// Light and dark switch for the journey mockup. The label names the theme a click moves to.
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="10" cy="10" r="3.6" />
    <path d="M10 1.8v2.1M10 16.1v2.1M1.8 10h2.1M16.1 10h2.1M4.2 4.2l1.5 1.5M14.3 14.3l1.5 1.5M4.2 15.8l1.5-1.5M14.3 5.7l1.5-1.5" />
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 20 20" aria-hidden="true">
    <path d="M15.6 12.6A6.6 6.6 0 0 1 7.4 4.4a6.6 6.6 0 1 0 8.2 8.2Z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-button-sm);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .theme-toggle__icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the theme a click switches to. */
  :global([data-theme='dark']) .theme-toggle__icon--moon,
  :global([data-theme='light']) .theme-toggle__icon--sun {
    display: none;
  }
</style>

<script>
  const sync = (button: Element) => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    sync(button);
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('sc-theme', next);
      } catch {}
      document.querySelectorAll('[data-theme-toggle]').forEach(sync);
    });
  });
</script>
