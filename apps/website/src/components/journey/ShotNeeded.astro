---
/*
  A reserved frame for a screenshot that has not been captured yet. Same 16:9
  light frame as DocFigure, so the page does not reflow when the real still
  lands, but hatched and labelled so it can never pass for a finished picture.
  It names what the shot must show and how it gets made.
*/
interface Props {
  /** What the finished screenshot shows, in one sentence. */
  shows: string;
  /** How it gets made, e.g. a live VS Code capture or a Storybook story. */
  source: string;
  caption?: string;
}

const { shows, source, caption } = Astro.props;
---

<figure class="shot-needed not-content">
  <div class="shot-needed__frame" role="img" aria-label={`Screenshot not captured yet: ${shows}`}>
    <p class="shot-needed__flag">Screenshot to capture</p>
    <p class="shot-needed__shows">{shows}</p>
    <p class="shot-needed__source">{source}</p>
  </div>
  {caption && <figcaption class="shot-needed__caption">{caption}</figcaption>}
</figure>

<style>
  .shot-needed {
    margin: 1.1rem 0 1.6rem;
  }

  /* The frame is light in both site themes, like every DocFigure, so its text
     colours are fixed rather than read from the theme. */
  .shot-needed__frame {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.45rem;
    aspect-ratio: 16 / 9;
    padding: 1.25rem 8%;
    background:
      repeating-linear-gradient(-45deg, transparent 0 10px, rgb(24 20 45 / 0.05) 10px 11px),
      #eeedf3;
    border: 1.5px dashed #a9a3c4;
    border-radius: var(--radius-md);
  }

  .shot-needed__flag {
    align-self: flex-start;
    margin: 0;
    padding: 0.15rem 0.55rem;
    font-size: var(--fs-mono);
    font-weight: var(--fw-semibold);
    color: #ffffff;
    background: #5b5578;
    border-radius: var(--radius-pill);
  }

  .shot-needed__shows {
    margin: 0;
    max-width: 30rem;
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    line-height: 1.45;
    color: #1a1630;
  }

  .shot-needed__source {
    margin: 0;
    font-size: var(--fs-ui-sm);
    line-height: var(--lh-ui);
    color: #4a4566;
  }

  .shot-needed__caption {
    margin-top: 0.55rem;
    font-size: var(--fs-ui-sm);
    line-height: var(--lh-ui);
    color: var(--text-muted);
  }

  @media (max-width: 30rem) {
    .shot-needed__frame {
      aspect-ratio: auto;
      min-height: 11rem;
      padding: 1rem;
    }
  }
</style>
