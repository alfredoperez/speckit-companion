---
/*
  A reserved frame for a screenshot that has not been captured yet. It is
  hatched and labelled so it can never pass for a finished picture, and it
  names what the shot must show and where it comes from, so whoever captures
  it does not have to guess. Sized to the capture aspect (1836x1164), or
  portrait for a tall view, so the page does not reflow when the real one lands.
*/
interface Props {
  /** What the finished screenshot shows, in one sentence. */
  shows: string;
  /** How it gets made, e.g. a live VS Code capture or a Storybook story. */
  source: string;
  caption?: string;
  shape?: 'landscape' | 'portrait';
}

const { shows, source, caption, shape = 'landscape' } = Astro.props;
---

<figure class:list={["shot-needed", `shot-needed--${shape}`, "not-content"]}>
  <div class="shot-needed__frame" role="img" aria-label={`Screenshot not captured yet: ${shows}`}>
    <p class="shot-needed__flag">Screenshot to capture</p>
    <p class="shot-needed__shows">{shows}</p>
    <p class="shot-needed__source">{source}</p>
  </div>
  {caption && <figcaption class="shot-needed__caption">{caption}</figcaption>}
</figure>

<style>
  .shot-needed {
    margin: 0;
  }

  .shot-needed__frame {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.45rem;
    aspect-ratio: 1836 / 1164;
    padding: 1.25rem 1.5rem;
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0 10px,
        color-mix(in srgb, var(--text-dim) 9%, transparent) 10px 11px
      ),
      var(--ground);
    border: 1.5px dashed var(--border-strong);
    border-radius: var(--radius-sm);
  }

  .shot-needed--portrait .shot-needed__frame {
    aspect-ratio: 3 / 5;
    max-height: 30rem;
  }

  .shot-needed__flag {
    align-self: flex-start;
    margin: 0;
    padding: 0.15rem 0.55rem;
    font-size: var(--fs-mono);
    font-weight: var(--fw-semibold);
    color: var(--ground);
    background: var(--text-muted);
    border-radius: var(--radius-pill);
  }

  .shot-needed__shows {
    margin: 0;
    max-width: 30rem;
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    line-height: 1.45;
    color: var(--text-primary);
  }

  .shot-needed__source {
    margin: 0;
    font-size: var(--fs-ui-sm);
    line-height: var(--lh-ui);
    color: var(--text-muted);
  }

  .shot-needed__caption {
    margin-top: 0.5rem;
    font-size: var(--fs-ui-sm);
    line-height: var(--lh-ui);
    color: var(--text-muted);
  }

  @media (max-width: 30rem) {
    .shot-needed__frame {
      aspect-ratio: auto;
      min-height: 11rem;
      padding: 1rem;
    }
  }
</style>
