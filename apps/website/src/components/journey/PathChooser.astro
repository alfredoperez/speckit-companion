---
// The three places you can work, as cards that open that place's Install page.
// `id` and `stepIds` keep the anchors of the page that once held every path, so
// an old hash link lands on the card that leads to those steps.
interface Choice {
  id?: string;
  stepIds?: string[];
  go?: string;
  kind: string;
  name: string;
  body: string;
  href: string;
}

interface Props {
  choices: Choice[];
}

const { choices } = Astro.props;
---

<nav class="jpath not-content" aria-label="Where you work">
  {
    choices.map((choice) => (
      <a class="jpath__card" id={choice.id} href={choice.href}>
        {choice.stepIds && (
          <span class="jpath__anchors" aria-hidden="true">
            {choice.stepIds.map((stepId) => (
              <span id={stepId} />
            ))}
          </span>
        )}
        <span class="jpath__kind">{choice.kind}</span>
        <span class="jpath__name">{choice.name}</span>
        <span class="jpath__body">{choice.body}</span>
        <span class="jpath__go" aria-hidden="true">
          {choice.go ?? 'Open the steps'} →
        </span>
      </a>
    ))
  }
</nav>

<style>
  .jpath {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-14);
    margin-block: var(--space-20) var(--space-24);
  }

  .jpath__anchors {
    position: absolute;
    inset: 0 auto auto 0;
  }

  .jpath__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-18);
    background: var(--panel);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .jpath__card:hover {
    border-color: var(--border-accent);
  }

  .jpath__card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .jpath__kind {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-eyebrow-sm);
  }

  .jpath__name {
    color: var(--text-primary);
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    line-height: 1.3;
  }

  .jpath__body {
    flex: 1;
    color: var(--text-body);
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
  }

  .jpath__go {
    margin-top: var(--space-4);
    color: var(--accent);
    font-size: var(--fs-ui-sm);
    font-weight: var(--fw-semibold);
  }

  @media (max-width: 50rem) {
    .jpath {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
