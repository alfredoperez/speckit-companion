---
/*
  The spec journey as one line of stops, grouped by how often each runs:
  install once, write the constitution once per project, then specify through
  converge for every feature, with implement and converge repeating until the
  code matches the spec. `covered` lights the stops the current page walks.
*/
interface Props {
  covered?: string[];
  caption?: string;
}

const { covered = [], caption } = Astro.props;

const groups = [
  { scope: 'Once', stops: [{ id: 'install', label: 'Install' }] },
  { scope: 'Once per project', stops: [{ id: 'constitution', label: 'Constitution' }] },
  {
    scope: 'Every feature',
    stops: [
      { id: 'specify', label: 'Specify' },
      { id: 'plan', label: 'Plan' },
      { id: 'tasks', label: 'Tasks' },
    ],
    loop: [
      { id: 'implement', label: 'Implement' },
      { id: 'converge', label: 'Converge' },
    ],
  },
];

const isOn = (id: string) => covered.includes(id);
---

<figure class="jmap not-content">
  <ol class="jmap__groups" role="list">
    {
      groups.map((group) => (
        <li class="jmap__group">
          <ol class="jmap__stops" role="list">
            {group.stops.map((stop) => (
              <li class:list={['jmap__stop', isOn(stop.id) && 'is-on']}>
                <span class="jmap__dot" aria-hidden="true" />
                {stop.label}
                {isOn(stop.id) && <span class="sr-only">, covered on this page</span>}
              </li>
            ))}
            {group.loop && (
              <li class="jmap__loop">
                <ol class="jmap__stops" role="list">
                  {group.loop.map((stop) => (
                    <li class:list={['jmap__stop', isOn(stop.id) && 'is-on']}>
                      <span class="jmap__dot" aria-hidden="true" />
                      {stop.label}
                    </li>
                  ))}
                </ol>
                <span class="jmap__loop-note">
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5v2.8h-2.8" />
                  </svg>
                  repeat until converged
                </span>
              </li>
            )}
          </ol>
          <p class="jmap__scope">{group.scope}</p>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption class="jmap__caption">{caption}</figcaption>}
</figure>

<style>
  .jmap {
    margin: 1.4rem 0 0;
    padding: 1rem 1.1rem 0.9rem;
    background: var(--panel);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
  }

  .jmap__groups,
  .jmap__stops {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jmap__groups {
    gap: 0.9rem 1.4rem;
  }

  .jmap__stops {
    align-items: center;
    gap: 0.4rem;
  }

  .jmap__group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .jmap__stop {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.65rem 0.28rem 0.5rem;
    font-size: var(--fs-ui-sm);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    color: var(--text-muted);
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .jmap__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid var(--text-dim);
    border-radius: 50%;
  }

  /* The stops this page walks take the stem's green: the same colour that runs
     down the steps below, so the map and the page read as one path. */
  .jmap__stop.is-on {
    color: var(--text-primary);
    border-color: color-mix(in srgb, var(--green) 55%, transparent);
    background: color-mix(in srgb, var(--green) 12%, transparent);
  }

  .jmap__stop.is-on .jmap__dot {
    background: var(--green);
    border-color: var(--green);
  }

  .jmap__loop {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 0.35rem 0.5rem 0.3rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
  }

  .jmap__loop-note {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-left: 0.2rem;
    font-size: var(--fs-mono);
    color: var(--text-muted);
  }

  .jmap__loop-note svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .jmap__scope {
    margin: 0;
    padding-top: 0.35rem;
    font-size: var(--fs-mono);
    color: var(--text-muted);
    border-top: 1px solid var(--rule);
  }

  .jmap__caption {
    margin-top: 0.85rem;
    font-size: var(--fs-ui-sm);
    line-height: var(--lh-ui);
    color: var(--text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
