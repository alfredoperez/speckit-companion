---
/**
 * One release: its header and lead, then a section per topic. A topic opens on
 * its screenshots, names its highlights in one sentence each, and lists its
 * small entries one line each. The HTML arrives already rendered from the page,
 * which owns the single markdown processor.
 */
import HighlightMedia from './HighlightMedia.astro';
import type { PrLink, ProductId } from './parseChangelog';
import type { Shot } from './releaseMedia';

export interface RenderedHighlight {
  id: string;
  title: string;
  leadHtml: string;
  restHtml: string;
  prs: PrLink[];
}

export interface RenderedEntry {
  type: string;
  leadHtml: string;
  restHtml: string;
  prs: PrLink[];
}

export interface RenderedTopic {
  area: string;
  label: string;
  shots: Shot[];
  highlights: RenderedHighlight[];
  entries: RenderedEntry[];
}

interface Props {
  id: string;
  product: ProductId;
  productLabel: string;
  version: string | null;
  date: string | null;
  unreleased: boolean;
  latest?: boolean;
  lead: string;
  topics: RenderedTopic[];
  changeCount: number;
  open: boolean;
}

const { id, product, productLabel, version, date, unreleased, latest, lead, topics, changeCount, open } = Astro.props;

const prLabel = (pr: PrLink) => (/\/issues\//.test(pr.url) ? `Issue ${pr.number}` : `Pull request ${pr.number}`);
---

<article class="cl-release" id={id} data-product={product} data-unreleased={unreleased ? 'true' : 'false'}>
  <header class="cl-release-head">
    <div class="cl-release-head-top">
      <h2 class="cl-release-title">
        <span class:list={['cl-product', `cl-product--${product}`]}>{productLabel}</span>
        <span class="cl-version">{unreleased ? 'Not released yet' : version}</span>
        {latest && <span class="cl-latest">Latest</span>}
      </h2>
      {date && (
        <a class="cl-date" href={`#${id}`} aria-label={`Link to ${productLabel} ${version}`}>
          <time datetime={date}>{date}</time>
        </a>
      )}
    </div>
    <p class="cl-lead">{lead}</p>
  </header>

  {changeCount > 0 && (
    <details class="cl-body" open={open}>
      <summary class="cl-also-head">
        <span class="cl-also-title">{open ? 'Changes' : 'Show changes'}</span>
        <span class="cl-also-count">{changeCount} {changeCount === 1 ? 'change' : 'changes'}</span>
        <span class="cl-chevron" aria-hidden="true"></span>
      </summary>

      {topics.map((topic) => (
        <section class="cl-topic">
          <h3 class="cl-topic-title">{topic.label}</h3>
          {topic.shots.length > 0 && <HighlightMedia shots={topic.shots} label={`${topic.label}, screenshots`} />}
          <ul class="cl-entries">
            {topic.highlights.map((highlight) => (
              <li class="cl-entry cl-entry--highlight" id={highlight.id}>
                <span class="cl-tag cl-tag--new">New</span>
                <div class="cl-entry-main">
                  <span class="cl-entry-line">
                    <strong>{highlight.title}.</strong>{' '}
                    <span set:html={highlight.leadHtml} />
                    {highlight.prs.map((pr) => (
                      <a class="cl-pr" href={pr.url} aria-label={prLabel(pr)}>#{pr.number}</a>
                    ))}
                  </span>
                  {highlight.restHtml && (
                    <details class="cl-more">
                      <summary>More</summary>
                      <div class="cl-prose" set:html={highlight.restHtml} />
                    </details>
                  )}
                </div>
              </li>
            ))}
            {topic.entries.map((entry) => (
              <li class="cl-entry">
                <span class:list={['cl-tag', `cl-tag--${entry.type.toLowerCase()}`]}>{entry.type}</span>
                <div class="cl-entry-main">
                  <span class="cl-entry-line">
                    <span set:html={entry.leadHtml} />
                    {entry.prs.map((pr) => (
                      <a class="cl-pr" href={pr.url} aria-label={prLabel(pr)}>#{pr.number}</a>
                    ))}
                  </span>
                  {entry.restHtml && (
                    <details class="cl-more">
                      <summary>More</summary>
                      <div class="cl-prose" set:html={entry.restHtml} />
                    </details>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </details>
  )}
</article>
