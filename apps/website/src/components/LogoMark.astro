const ARM_TOP =
  'M170.9 232.63L89.44 153.61C72.98 137.67 46.88 115.02 34.44 96.61C9.21 59.25 36.58 2.46 82.89 1.29C113.53 0.52 130.63 23.82 150.46 43.28C156.76 49.48 162.92 55.91 169.12 62.22C197.56 91.23 226.29 119.94 255.31 148.36C265.23 158.37 331.99 223.45 332.76 229.72C327 240.01 262.65 300.94 250.99 310.16C225.07 285.72 196.37 257.63 170.9 232.63z';

const ELBOW_TOP =
  'M255.31 148.36C265.23 158.37 331.99 223.45 332.76 229.72C327 240.01 262.65 300.94 250.99 310.16C225.07 285.72 196.37 257.63 170.9 232.63C182.57 222.24 194.88 208.93 205.94 197.69L255.31 148.36z';

const ARM_BOTTOM =
  'M169.67 451.43C195.29 425.65 225.42 394.59 251.81 369.89C259.8 376.73 331.49 446.43 332.55 451.22C327.33 461.58 267.72 520.38 254.9 533.4C217.03 571.66 179.03 609.89 141.17 648.15C124.85 664.65 110.3 677.32 85.8 677.01C71.59 676.84 56.35 671.51 46.27 661.13C34.73 649.07 28.38 632.97 28.59 616.27C29.14 581.69 58.75 560.4 81.65 537.76L169.67 451.43z';

const ELBOW_BOTTOM =
  'M169.67 451.43C195.29 425.65 225.42 394.59 251.81 369.89C259.8 376.73 331.49 446.43 332.55 451.22C327.33 461.58 267.72 520.38 254.9 533.4C247.76 528.06 238.53 518.09 231.94 511.6L198.44 478.94C188.92 469.52 180.03 459.91 169.67 451.43z';

const CHECK =
  'M403.53 293.71C410.8 296.72 428.95 311.41 420 319.53C410.87 327.82 352.9 390.82 345.5 391.67C337.78 389.59 326.89 376.49 320.97 370.33C305.4 355.01 285.95 346.93 316.27 328.27C321.28 325.19 339.21 345.41 344.31 349.18L345.51 350.05C357.26 337.99 391.83 301.3 403.53 293.71z';
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 678 678"
  fill="none"
  role={labelled ? 'img' : undefined}
  aria-label={labelled ? title : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}

  <path fill={pale} d={RIGHT}></path>
  <path fill={violet} d={ARM_TOP}></path>
  <path fill={pale} d={ELBOW_TOP}></path>
  <path fill={violet} d={ARM_BOTTOM}></path>
  <path fill={pale} d={ELBOW_BOTTOM}></path>
  <path fill={pale} d={CHECK}></path>
</svg>

<style>
  .logo-mark {
    display: block;
    flex: none;
  }
</style>
