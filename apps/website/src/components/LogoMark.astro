---
/*
  The logo mark: a double chevron with a checkmark tucked inside the right one.
  Two chevrons for the pipeline moving forward, the check for the step that
  landed.

  The path data is the chosen artwork, translated into a square 678 box and
  otherwise untouched. Nothing is redrawn here — the left chevron's arms really
  do run violet at the outer end and light near the elbow, and the right chevron
  really is one continuous stroke. Six paths, no raster.

  The mark carries no ground of its own, so it sits on whatever surface it lands
  on. That works everywhere on this site because the site is dark only; the
  favicon is the one place a ground is forced, and it is a separate file for
  exactly that reason (see public/favicon.svg).

  Colour is prop-driven and defaults to the brand pair. mono collapses the whole
  mark onto currentColor for a monochrome context.

  This is the full mark. It is NOT the favicon: at 32px the checkmark is gone
  and at 16px the whole thing is a violet blob. public/favicon.svg is the small
  cut — same two chevrons, no check, thicker, wider gap.
*/
interface Props {
  size?: number;
  title?: string;
  accent?: string;
  light?: string;
  mono?: boolean;
  class?: string;
}

const {
  size = 24,
  title,
  accent = 'var(--accent)',
  light = 'var(--text-primary)',
  mono = false,
  class: className,
} = Astro.props;

const violet = mono ? 'currentColor' : accent;
const pale = mono ? 'currentColor' : light;
const labelled = Boolean(title);

/* Right chevron, then the left chevron's two arms — each drawn violet and then
   overpainted pale from the elbow in — then the check. */
const RIGHT =
