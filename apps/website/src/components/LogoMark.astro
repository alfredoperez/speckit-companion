---
/*
  The logo mark: the small moss mascot, inlined from assets/icons/moss.svg at
  build time so there is one copy of the artwork in the repo.

  The viewBox is cropped to the creature (the source file pads it inside a 32
  box), so a 24px mark gives the body and face about 20px of room. The source
  reads from about 24px up; below that the face closes into a green blob, and
  the 16px favicon is a separate simplified cut (assets/icons/moss-16.svg).

  Gradient ids are prefixed so they cannot collide with an id elsewhere on the
  page. The mark carries its own colours and dark outline, so it sits on any
  ground without props.
*/
import mossSource from '../../../../assets/icons/moss.svg?raw';

interface Props {
  size?: number;
  title?: string;
  class?: string;
}

const { size = 24, title, class: className } = Astro.props;
const labelled = Boolean(title);

const inner = mossSource
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/id="(body|sheen)"/g, 'id="logo-moss-$1"')
  .replace(/url\(#(body|sheen)\)/g, 'url(#logo-moss-$1)');
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="2 4 28 28"
  role={labelled ? 'img' : undefined}
  aria-label={labelled ? title : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={inner} />
</svg>

<style>
  .logo-mark {
    display: block;
    flex: none;
  }
</style>
