---
/*
  The mono command row: one surface, a dim prompt glyph, the command, and a copy
  button at the right edge. A button means click, this row means copy, and the
  shape says which without a label.

  A shell command leads with `$`. A slash command already starts with its own
  glyph, so with `prompt={false}` the leading `/` is the dim one. The copied
  text is always the whole command, read from the row, never from the spans.

  The text tint #cfc9e8 is a single-use value in the token sheet, so it stays a
  literal here rather than becoming a token.

  Unknown props land on the copy button, not on the wrapper. The one thing a
  caller wants to describe here is the copy itself, and the analytics listener
  walks up from the click target, so an attribute on the wrapper would also fire
  when someone just clicks the command text.

  The click is handled from the document, once. The docs swap pages in place, so
  a listener bound to the rows of the first page would miss every row after it.
*/
interface Props {
  command: string;
  prompt?: boolean;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const { command, prompt = true, label, class: className, ...rest } = Astro.props;
const copyLabel = label ?? `Copy: ${command}`;
const slash = !prompt && command.startsWith('/');
const glyph = prompt ? '$' : slash ? '/' : undefined;
const text = slash ? command.slice(1) : command;
---

<div class:list={['code-line', className, slash && 'code-line--slash']} data-code-line data-command={command}>
  <code>
    {glyph && <span class="prompt" aria-hidden={prompt ? 'true' : undefined}>{glyph}</span>}
    <span class="text">{text}</span>
  </code>

  <span class="copied" aria-hidden="true">Copied</span>

  <button type="button" class="copy" data-copy-button aria-label={copyLabel} {...rest}>
    <svg class="icon icon--copy" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.75" />
      <path d="M10.5 3.25A1.75 1.75 0 0 0 8.75 1.5h-5A2.25 2.25 0 0 0 1.5 3.75v5c0 .97.78 1.75 1.75 1.75" />
    </svg>
    <svg class="icon icon--done" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8.4 6.3 11.7 13 5" />
    </svg>
  </button>

  <span class="status" role="status" aria-live="polite" data-copy-status></span>
</div>

<style>
  .code-line {
    --code-line-surface: var(--panel);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    max-width: 100%;
    min-height: 44px;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-16);
    background: var(--code-line-surface);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    transition: border-color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .code-line:hover,
  .code-line:focus-within {
    border-color: var(--border-panel);
  }

  /* Qualified so the row owns its text wherever it is placed: a docs page gives
     every inline code a fill and a chip shape, and this is not a chip. */
  .code-line code {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--space-10);
    min-width: 0;
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-ui-sm);
    line-height: var(--lh-ui);
    color: #cfc9e8;
  }

  .code-line--slash code {
    gap: 0;
  }

  .prompt {
    flex: none;
    color: var(--text-dim);
    user-select: none;
  }

  .code-line--slash .prompt {
    user-select: auto;
  }

  .text {
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .text::-webkit-scrollbar {
    display: none;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 34px;
    height: 34px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-button-sm);
    cursor: pointer;
    color: var(--text-muted);
    transition:
      color 160ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .copy:hover {
    color: var(--text-primary);
    background: var(--accent-solid-a25);
  }

  .copy:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .icon {
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon--done {
    display: none;
  }

  /* The word sits over the tail of the command, on the row's own surface, so
     the row keeps its width while it confirms. */
  .copied {
    position: absolute;
    inset-block: 1px;
    inset-inline-end: 42px;
    display: none;
    align-items: center;
    padding-inline: var(--space-26) var(--space-6);
    background: linear-gradient(to right, transparent, var(--code-line-surface) var(--space-20));
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--green);
    pointer-events: none;
  }

  .code-line[data-copied] .copied {
    display: flex;
  }

  .code-line[data-copied] .copy,
  .code-line[data-copied] .copy:hover {
    color: var(--green);
    background: none;
  }

  .code-line[data-copied] .icon--copy {
    display: none;
  }

  .code-line[data-copied] .icon--done {
    display: block;
  }

  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .code-line {
      display: flex;
      align-self: stretch;
      width: 100%;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      __codeLineCopy?: boolean;
    }
  }

  const timers = new WeakMap<Element, ReturnType<typeof setTimeout>>();

  if (!window.__codeLineCopy) {
    window.__codeLineCopy = true;

    document.addEventListener('click', async (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-copy-button]') : null;
      const row = button?.closest('[data-code-line]');
      if (!row) return;

      const status = row.querySelector('[data-copy-status]');
      try {
        await navigator.clipboard.writeText(row.getAttribute('data-command') ?? '');
      } catch {
        if (status) status.textContent = 'Copy failed. Select the command and copy it by hand.';
        return;
      }

      row.setAttribute('data-copied', '');
      if (status) status.textContent = 'Copied';
      clearTimeout(timers.get(row));
      timers.set(
        row,
        setTimeout(() => {
          row.removeAttribute('data-copied');
          if (status) status.textContent = '';
        }, 1600),
      );
    });
  }
</script>
