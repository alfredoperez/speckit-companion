---
/*
  The mono command row. A button means click, a chip means copy, and the shape
  says which without a label.

  The text tint #cfc9e8 is a single-use value in the token sheet, so it stays a
  literal here rather than becoming a token.

  Unknown props land on the copy button, not on the wrapper. The one thing a
  caller wants to describe here is the copy itself, and the analytics listener
  walks up from the click target, so an attribute on the wrapper would also fire
  when someone just clicks the command text.
*/
interface Props {
  command: string;
  prompt?: boolean;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const { command, prompt = true, label, class: className, ...rest } = Astro.props;
const copyLabel = label ?? `Copy: ${command}`;
---

<div class:list={['code-line', className]} data-code-line>
  <code>
    {prompt && <span class="prompt" aria-hidden="true">$</span>}
    <span class="text" data-code-text>{command}</span>
  </code>

  <button type="button" class="copy" data-copy-button aria-label={copyLabel} {...rest}>
    <svg class="icon icon--copy" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.75" />
      <path d="M10.5 3.25A1.75 1.75 0 0 0 8.75 1.5h-5A2.25 2.25 0 0 0 1.5 3.75v5c0 .97.78 1.75 1.75 1.75" />
    </svg>
    <svg class="icon icon--done" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8.4 6.3 11.7 13 5" />
    </svg>
  </button>

  <span class="status" role="status" aria-live="polite" data-copy-status></span>
</div>

<style>
  .code-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    max-width: 100%;
    padding: 12px 16px;
    background: var(--ground);
    border: 1px solid var(--rule);
    border-radius: var(--radius-button-sm);
  }

  code {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: #cfc9e8;
  }

  .prompt {
    color: var(--text-dim);
    flex: none;
  }

  .text {
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .text::-webkit-scrollbar {
    display: none;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--text-dim);
    transition: color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .copy:hover {
    color: var(--accent);
  }

  .copy:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .icon {
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon--done {
    display: none;
    stroke: var(--green);
  }

  .code-line[data-copied] .icon--copy {
    display: none;
  }

  .code-line[data-copied] .icon--done {
    display: block;
  }

  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  document.querySelectorAll('[data-code-line]').forEach((row) => {
    const button = row.querySelector('[data-copy-button]');
    const text = row.querySelector('[data-code-text]');
    const status = row.querySelector('[data-copy-status]');
    if (!button || !text) return;

    let timer;

    button.addEventListener('click', async () => {
      const value = text.textContent ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        if (status) status.textContent = 'Copy failed. Select the command and copy it by hand.';
        return;
      }
      row.setAttribute('data-copied', '');
      if (status) status.textContent = 'Copied';
      clearTimeout(timer);
      timer = setTimeout(() => {
        row.removeAttribute('data-copied');
        if (status) status.textContent = '';
      }, 1600);
    });
  });
</script>
