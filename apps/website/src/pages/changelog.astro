---
/**
 * /changelog
 *
 * Two products ship from this repo, each with its own version and its own
 * CHANGELOG.md. Both files are read and parsed at build time and merged into one
 * reverse chronological list, so this page cannot drift from the sources.
 *
 *   VS Code extension   -> ../../../../CHANGELOG.md              (package.json version)
 *   Spec Kit extension  -> ../../../../apps/speckit-extension/CHANGELOG.md (extension.yml version)
 *   Copilot app canvas  -> ../../../../apps/copilot-canvas/CHANGELOG.md (package.json version)
 *   Claude Code mod     -> ../../../../apps/claude-mod/CHANGELOG.md (plugin.json version)
 *
 * `.specify/extensions/companion/CHANGELOG.md` is generated and gitignored. It is
 * never read here.
 *
 * A release is laid out by topic. A topic opens on its screenshots, then names
 * its highlights in one sentence each, then lists its small entries one line each.
 * Screenshots come from content/media/changelog.json; see releaseMedia.ts.
 *
 * Unreleased blocks are kept, not dropped, and rendered under their own "Shipping next"
 * tab so nothing in there can be mistaken for shipped.
 */
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

// Imported with Vite's ?raw so the two files are inlined at build time and the
// path is resolved relative to this source file, not to the build's cwd.
import vscodeChangelogCurrent from '../../../../CHANGELOG.md?raw';
// The archive holds 0.30.0 and older; this page is the whole history, so it reads both.
import vscodeChangelogArchive from '../data/changelog-archive.md?raw';
import speckitChangelog from '../../../../apps/speckit-extension/CHANGELOG.md?raw';
import copilotChangelog from '../../../../apps/copilot-canvas/CHANGELOG.md?raw';
import modChangelog from '../../../../apps/claude-mod/CHANGELOG.md?raw';

const vscodeChangelog = `${vscodeChangelogCurrent}\n${vscodeChangelogArchive}`;

import Analytics from '../components/Analytics.astro';
import LogoMark from '../components/LogoMark.astro';
import SiteIcons from '../components/SiteIcons.astro';
import ogCard from '../../../../docs/screenshots/generated/og-card.png';
import ReleaseCard from '../components/changelog/ReleaseCard.astro';
import type { RenderedTopic } from '../components/changelog/ReleaseCard.astro';
import { isBrief, markHighlights, mergeReleases, parseChangelog, unreleasedOf } from '../components/changelog/parseChangelog';
import type { Release } from '../components/changelog/parseChangelog';
import { mediaKey, resolveMedia } from '../components/changelog/releaseMedia';
import { leadFor } from '../components/changelog/releaseLead';
import { areaLabel, areaRank } from '../components/changelog/changelogAreas';

const vscodeStream = parseChangelog(vscodeChangelog, 'vscode', 'VS Code extension');
const speckitStream = parseChangelog(speckitChangelog, 'speckit', 'Spec Kit extension');

const copilotStream = parseChangelog(copilotChangelog, 'copilot', 'Copilot app');
const modStream = parseChangelog(modChangelog, 'mod', 'Claude Code mod');

const streams = [vscodeStream, speckitStream, copilotStream, modStream];
const released = mergeReleases(streams);
const unreleased = unreleasedOf(streams);
const everyRelease = [...unreleased, ...released];

const media = resolveMedia(everyRelease);

// A release that tags any entry is written in the new shape and should tag them all; older ones lean on the keyword map.
let guessedOld = 0;
for (const release of everyRelease) {
  const current = release.unreleased || release.entries.some((entry) => !entry.areaGuessed);
  const items = [...release.highlights.map((h) => ({ ...h, lead: h.title })), ...release.entries];
  for (const item of items) {
    if (!item.areaGuessed) continue;
    if (!current) {
      guessedOld += 1;
      continue;
    }
    console.warn(
      `[changelog] ${mediaKey(release.product, release.version)} "${item.lead.slice(0, 60)}" has no area tag, filed under ${item.area} by keyword.`
    );
  }
}
if (guessedOld > 0) {
  console.warn(`[changelog] ${guessedOld} entries in older releases have no area tag and were filed by keyword.`);
}

const processor = await createMarkdownProcessor({});
const renderBlock = async (markdown: string) =>
  markdown ? markHighlights((await processor.render(markdown)).code) : '';
const renderInline = async (markdown: string) =>
  (await renderBlock(markdown)).trim().replace(/^<p>/, '').replace(/<\/p>$/, '');

const latestIds = new Set(
  (['vscode', 'speckit', 'copilot', 'mod'] as const).map((product) => released.find((r) => r.product === product)?.id)
);

// A highlight leads with one sentence; the rest waits behind "More".
const splitLead = (markdown: string): [string, string] => {
  const text = markdown.trim();
  const paragraphEnd = text.search(/\n\s*\n/);
  const paragraph = paragraphEnd === -1 ? text : text.slice(0, paragraphEnd);
  const sentence = paragraph.match(/^[\s\S]*?[.!?](?=\s|$)/);
  const first = sentence ? sentence[0] : paragraph;
  return [first.replace(/\s+/g, ' '), text.slice(first.length).trim()];
};

const renderRelease = async (release: Release, open: boolean) => {
  const shots = media.get(mediaKey(release.product, release.version));
  const topics = new Map<string, RenderedTopic>();
  const topicFor = (area: string) => {
    let topic = topics.get(area);
    if (!topic) {
      topic = { area, label: areaLabel(area), shots: [], highlights: [], entries: [] };
      topics.set(area, topic);
    }
    return topic;
  };

  for (const highlight of release.highlights) {
    const topic = topicFor(highlight.area);
    // Two short sentences sit on the line together; only a longer body waits behind More.
    const [first, rest] = isBrief(highlight.markdown, 50) ? [highlight.markdown.trim(), ''] : splitLead(highlight.markdown);
    topic.shots.push(...highlight.media.map((id) => shots!.get(id)!));
    topic.highlights.push({
      id: highlight.id,
      title: highlight.title,
      leadHtml: await renderInline(first),
      restHtml: await renderBlock(rest),
      prs: highlight.prs,
    });
  }
  for (const entry of release.entries) {
    const inline = entry.titled && isBrief(entry.rest);
    topicFor(entry.area).entries.push({
      type: entry.type,
      titled: entry.titled,
      leadHtml: await renderInline(entry.lead),
      sayHtml: inline ? await renderInline(entry.rest) : '',
      restHtml: inline ? '' : await renderBlock(entry.rest),
      prs: entry.prs,
    });
  }

  // Topics with pictures lead, then the product's usual area order.
  const ordered = [...topics.values()].sort(
    (x, y) => Number(y.shots.length > 0) - Number(x.shots.length > 0) || areaRank(x.area) - areaRank(y.area)
  );

  return {
    id: release.id,
    product: release.product,
    productLabel: release.productLabel,
    version: release.version,
    date: release.date,
    unreleased: release.unreleased,
    latest: latestIds.has(release.id),
    lead: leadFor(release),
    topics: ordered,
    changeCount: release.highlights.length + release.entries.length,
    open,
  };
};

const renderedUnreleased = await Promise.all(unreleased.map((release) => renderRelease(release, true)));
const renderedReleased = await Promise.all(released.map((release, index) => renderRelease(release, index < 4)));

const ogImageUrl = Astro.site ? new URL(ogCard.src, Astro.site).href : ogCard.src;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Changelog · SpecKit Companion</title>
    <meta
      name="description"
      content="Release notes for SpecKit Companion: the VS Code extension, the Spec Kit extension, the Copilot app and the Claude Code mod, merged newest first."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;800&family=Instrument+Serif:ital@1&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {/* This route builds its own document instead of using BaseLayout, so it
        has to mount all of these itself: the favicon links, the share card, and
        Analytics, or it would be the one page the funnel cannot see and the one
        link that shares as a bare text card. Analytics renders nothing without
        a key, same as everywhere. */}
    <SiteIcons />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <Analytics />
  </head>

  <body data-filter="all">
    <div class="cl-shell">
      <nav class="cl-nav">
        <a class="cl-back" href="/">
          <LogoMark size={24} />
          <span>SpecKit Companion</span>
        </a>
        <a class="cl-nav-link" href="/docs/">docs</a>
      </nav>

      <header class="cl-head">
        <h1>Changelog</h1>
      </header>

      <div class="cl-filters">
        <div class="cl-filter" role="group" aria-label="Filter releases by product">
          <button type="button" class="cl-pill is-active" data-filter="all" aria-pressed="true">
            All
          </button>
          <button type="button" class="cl-pill" data-filter="vscode" aria-pressed="false">
            VS Code<span class="cl-pill-more"> extension</span>
          </button>
          <button type="button" class="cl-pill" data-filter="speckit" aria-pressed="false">
            Spec Kit<span class="cl-pill-more"> extension</span>
          </button>
          <button type="button" class="cl-pill" data-filter="copilot" aria-pressed="false">
            Copilot<span class="cl-pill-more"> app</span>
          </button>
          <button type="button" class="cl-pill" data-filter="mod" aria-pressed="false">
            Claude Code<span class="cl-pill-more"> mod</span>
          </button>
        </div>

        {renderedUnreleased.length > 0 && (
          <div class="cl-filter" role="group" aria-label="Show upcoming changes">
            <button type="button" class="cl-pill cl-tab" data-tab="next" aria-pressed="false">
              Next
            </button>
          </div>
        )}

      </div>

      {renderedUnreleased.length > 0 && (
        <section class="cl-unreleased" id="unreleased" data-group="unreleased" hidden>
          <div class="cl-group-head">
            <h2 class="cl-group-title">Shipping <em>next</em></h2>
            <p class="cl-group-note">
              Merged and written up, but not in a released version yet. Each block ships with the
              next version of the half it sits under.
            </p>
          </div>
          <div class="cl-list">
            {renderedUnreleased.map((release) => <ReleaseCard {...release} />)}
          </div>
        </section>
      )}

      <p class="cl-empty" id="cl-empty" hidden>Nothing here for this product yet.</p>

      <section class="cl-released" id="released" data-group="released">
        <div class="cl-group-head">
          <h2 class="cl-group-title">Released</h2>
        </div>
        <div class="cl-list">
          {renderedReleased.map((release) => <ReleaseCard {...release} />)}
        </div>
      </section>

      <footer class="cl-foot">
        <p class="cl-foot-links">
          <a href="https://github.com/alfredoperez/speckit-companion/blob/main/CHANGELOG.md"
            >VS Code extension changelog</a
          >
          <a
            href="https://github.com/alfredoperez/speckit-companion/blob/main/apps/speckit-extension/CHANGELOG.md"
            >Spec Kit extension changelog</a
          >
          <a
            href="https://github.com/alfredoperez/speckit-companion/blob/main/apps/copilot-canvas/CHANGELOG.md"
            >Copilot app changelog</a
          >
          <a
            href="https://github.com/alfredoperez/speckit-companion/blob/main/apps/claude-mod/CHANGELOG.md"
            >Claude Code mod changelog</a
          >
          <a href="https://github.com/alfredoperez/speckit-companion">github</a>
        </p>
      </footer>
    </div>

    <script is:inline>
      // A permalink to a release or a highlight inside a collapsed list must show it.
      (function () {
        function openHash() {
          if (!location.hash) return;
          var target = document.querySelector(location.hash.replace(/[^#\w.-]/g, ''));
          if (!target) return;
          var box = target.closest('details.cl-body') || target.querySelector('details.cl-body');
          if (box) box.open = true;
          target.scrollIntoView();
        }
        window.addEventListener('hashchange', openHash);
        openHash();
      })();

      // Product filter and the Released / Shipping next tab.
      (function () {
        var products = Array.prototype.slice.call(document.querySelectorAll('.cl-pill[data-filter]'));
        var tabs = Array.prototype.slice.call(document.querySelectorAll('.cl-pill[data-tab]'));
        var product = 'all';
        var tab = 'released';
        var empty = document.getElementById('cl-empty');

        function press(list, active) {
          list.forEach(function (button) {
            var on = button === active;
            button.classList.toggle('is-active', on);
            button.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        }

        function apply() {
          document.body.setAttribute('data-filter', product);
          Array.prototype.forEach.call(document.querySelectorAll('.cl-release'), function (card) {
            card.hidden = product !== 'all' && card.getAttribute('data-product') !== product;
          });
          var shown = 0;
          Array.prototype.forEach.call(document.querySelectorAll('[data-group]'), function (group) {
            var wanted = group.getAttribute('data-group') === 'unreleased' ? tab === 'next' : tab === 'released';
            var visible = wanted && group.querySelectorAll('.cl-release:not([hidden])').length > 0;
            group.hidden = !visible;
            if (visible) shown += 1;
          });
          if (empty) empty.hidden = shown > 0;
        }

        function setTab(next) {
          tab = next;
          tabs.forEach(function (button) {
            button.classList.toggle('is-active', next === 'next');
            button.setAttribute('aria-pressed', next === 'next' ? 'true' : 'false');
          });
          apply();
        }

        products.forEach(function (button) {
          button.addEventListener('click', function () {
            product = button.getAttribute('data-filter');
            press(products, button);
            apply();
          });
        });
        tabs.forEach(function (button) {
          button.addEventListener('click', function () { setTab(tab === 'next' ? 'released' : 'next'); });
        });

        // A permalink into Shipping next must open that tab first.
        function showTabForHash() {
          if (!location.hash) return;
          var target = document.querySelector(location.hash.replace(/[^#\w.-]/g, ''));
          if (target && target.closest('#unreleased') && tabs.length) {
            product = 'all';
            press(products, products[0]);
            setTab('next');
            target.scrollIntoView();
          }
        }
        window.addEventListener('hashchange', showTabForHash);
        showTabForHash();
        apply();
      })();

      // Carousels: scroll-snap does the moving; buttons, dots and arrow keys drive it. No autoplay.
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        Array.prototype.forEach.call(document.querySelectorAll('.cl-carousel'), function (carousel) {
          var track = carousel.querySelector('.cl-track');
          var slides = track.querySelectorAll('.cl-slide');
          var dots = carousel.querySelectorAll('.cl-dot');
          var prev = carousel.querySelector('[data-step="-1"]');
          var next = carousel.querySelector('[data-step="1"]');
          var current = 0;

          function go(index) {
            index = Math.max(0, Math.min(slides.length - 1, index));
            track.scrollTo({ left: index * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
          }

          function sync() {
            current = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
            Array.prototype.forEach.call(dots, function (dot, i) {
              dot.setAttribute('aria-current', i === current ? 'true' : 'false');
            });
            Array.prototype.forEach.call(slides, function (slide, i) {
              slide.setAttribute('aria-hidden', i === current ? 'false' : 'true');
            });
            prev.disabled = current === 0;
            next.disabled = current === slides.length - 1;
          }

          var frame = 0;
          track.addEventListener('scroll', function () {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(sync);
          });
          prev.addEventListener('click', function () { go(current - 1); });
          next.addEventListener('click', function () { go(current + 1); });
          Array.prototype.forEach.call(dots, function (dot) {
            dot.addEventListener('click', function () { go(Number(dot.getAttribute('data-index'))); });
          });
          carousel.addEventListener('keydown', function (event) {
            if (event.key === 'ArrowLeft') { event.preventDefault(); go(current - 1); }
            if (event.key === 'ArrowRight') { event.preventDefault(); go(current + 1); }
          });
          sync();
        });
      })();
    </script>

    <style is:global>
      /*
        Tokens transcribed from the Constellation artboard token sheet.
        Dark only. There is no light palette in the source and none is invented
        here, so there's no prefers-color-scheme block and no theme toggle.
        Declared in the sheet's order: families, scale, ground, neutrals,
        accents, accent alphas, radii, shadows.
      */
      :root {
        color-scheme: dark;

        --font-sans: 'Figtree', 'Avenir Next', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --font-serif: 'Instrument Serif', Georgia, serif;

        /* Kept in step with src/styles/tokens.css, which is the scale's home.
           This page is a standalone route rather than a BaseLayout page, so it
           carries its own copy. Change one and change the other. */
        --fs-display: 60px;
        --fs-h2: 34px;
        --fs-h3: 20px;
        --fs-lead: 18px;
        --fs-body: 16px;
        --fs-ui: 14px;
        --fs-ui-sm: 13px;
        --fs-mono: 12px;
        --fs-micro: 10px;
        --fs-chip: 9px;

        --fw-regular: 400;
        --fw-medium: 500;
        --fw-semibold: 600;
        --fw-bold: 700;
        --fw-black: 800;

        --lh-display: 1.1;
        --lh-prose: 1.65;
        --lh-ui: 1.6;

        --ls-display: -0.03em;
        --ls-h2: -0.025em;
        --ls-chip: 0.1em;
        --ls-eyebrow-sm: 0.18em;
        --ls-eyebrow: 0.24em;
        --ls-eyebrow-lg: 0.28em;

        --ground: #0a0913;
        --panel: #0d0b1a;

        --text-primary: #edeaf6;
        --text-body: #b6b0d2;
        --text-muted: #9d97bd;
        --text-dim: #6f6994;
        --on-accent: #ffffff;

        --accent: #a78bfa;
        --accent-hover: #c4b5fd;
        --accent-solid: #8b5cf6;

        --rule: #1d1930;
        --border-card: #221e35;
        --border-panel: #2a2545;
        --border-strong: #3a3357;
        --border-accent: rgba(167, 139, 250, 0.25);

        --hero-grid: radial-gradient(circle, rgba(167, 139, 250, 0.07) 1px, rgba(10, 9, 19, 0) 1px);
        --shadow-figure: 0 12px 28px rgb(0 0 0 / 0.45);
        --scrim: rgb(10 9 19 / 0.62);

        --tag-added: #7ee0b5;
        --tag-fixed: #f2c879;
        --tag-security: #f59e8b;

        --radius-pill: 999px;
        --radius-md: 12px;
        --radius-sm: 10px;
        --radius-button-sm: 8px;
      }

      * {
        box-sizing: border-box;
      }

      [hidden] {
        display: none !important;
      }

      body {
        margin: 0;
        background: var(--ground);
        color: var(--text-primary);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        color: var(--accent-hover);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.92em;
        color: #cfc9e8;
        overflow-wrap: anywhere;
      }

      .cl-shell {
        max-width: 960px;
        margin: 0 auto;
      }

      /* Nav */
      .cl-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        padding: 20px 48px;
        font-family: var(--font-mono);
        font-size: var(--fs-mono);
      }

      /* The mark and the words are one control, so the anchor is the flex
         parent and the 10px gap matches the nav on every other page. */
      .cl-back {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: var(--fs-body);
        font-weight: var(--fw-black);
        letter-spacing: -0.01em;
      }

      .cl-nav-link {
        color: var(--text-muted);
      }

      /* Head */
      .cl-head {
        padding: 56px 48px 48px;
        background-image: var(--hero-grid);
        background-size: 26px 26px;
        border-top: 1px solid var(--rule);
      }


      .cl-head h1 {
        margin: 0 0 20px;
        font-size: clamp(38px, 8vw, var(--fs-display));
        font-weight: var(--fw-black);
        line-height: var(--lh-display);
        letter-spacing: var(--ls-display);
      }


      /* Filters */
      .cl-filters {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 0 48px 40px;
      }

      .cl-filter {
        display: flex;
        flex-wrap: nowrap;
        gap: 2px;
        width: fit-content;
        max-width: 100%;
        padding: 3px;
        overflow-x: auto;
        background: rgba(10, 9, 19, 0.6);
        border: 1px solid var(--border-accent);
        border-radius: var(--radius-pill);
      }

      .cl-pill {
        padding: 3px 10px;
        background: none;
        border: 1.5px solid transparent;
        border-radius: var(--radius-pill);
        color: var(--text-muted);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: var(--fw-semibold);
        white-space: nowrap;
        cursor: pointer;
      }

      .cl-pill:hover {
        color: var(--text-primary);
      }

      .cl-pill.is-active {
        border-color: var(--accent-solid);
        color: var(--text-primary);
        font-weight: var(--fw-bold);
      }

      .cl-unreleased,
      .cl-released {
        padding: 56px 48px;
        border-top: 1px solid var(--rule);
      }


      .cl-group-head {
        margin-bottom: 24px;
      }

      .cl-group-title {
        margin: 0 0 10px;
        font-size: var(--fs-h2);
        font-weight: var(--fw-black);
        letter-spacing: var(--ls-h2);
      }

      .cl-group-title em {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: var(--fw-regular);
        font-size: 1.06em;
        color: var(--accent);
      }

      .cl-group-note {
        max-width: 620px;
        margin: 0;
        color: var(--text-muted);
        font-size: var(--fs-ui-sm);
        line-height: var(--lh-ui);
      }

      .cl-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      /* Release */
      .cl-release {
        min-width: 0;
        padding: 28px;
        background: var(--panel);
        border: 1px solid var(--border-card);
        border-radius: var(--radius-md);
        scroll-margin-top: 16px;
      }

      .cl-unreleased .cl-release {
        border-style: dashed;
        border-color: var(--border-panel);
      }

      .cl-release-head-top {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .cl-release-title {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: var(--fs-body);
      }

      .cl-product {
        padding: 4px 12px;
        border-radius: var(--radius-pill);
        font-family: var(--font-mono);
        font-size: var(--fs-mono);
        font-weight: var(--fw-medium);
      }

      .cl-product--vscode {
        background: var(--accent-solid);
        color: var(--on-accent);
      }

      .cl-product--speckit,
      .cl-product--copilot,
      .cl-product--mod {
        border: 1px solid var(--border-strong);
        color: var(--accent);
      }

      .cl-empty {
        padding: 56px 48px;
        color: var(--text-muted);
      }

      .cl-version {
        font-size: var(--fs-h3);
        font-weight: var(--fw-black);
        letter-spacing: -0.01em;
        color: var(--text-primary);
      }

      .cl-latest {
        padding: 2px 8px;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-pill);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: var(--fs-micro);
        font-weight: var(--fw-medium);
        letter-spacing: var(--ls-chip);
        text-transform: uppercase;
      }

      .cl-date {
        font-family: var(--font-mono);
        font-size: var(--fs-mono);
        color: var(--text-muted);
      }

      .cl-date:hover {
        color: var(--accent);
      }

      .cl-lead {
        max-width: 720px;
        margin: 12px 0 0;
        color: var(--text-body);
        font-size: var(--fs-body);
        line-height: var(--lh-prose);
      }

      /* Topic: pictures first, then one line per change */
      .cl-topic {
        margin-top: 26px;
        padding-top: 22px;
        border-top: 1px solid var(--rule);
      }

      .cl-topic:first-of-type {
        margin-top: 8px;
        padding-top: 0;
        border-top: 0;
      }

      .cl-topic-title {
        margin: 0 0 4px;
        font-size: var(--fs-h3);
        font-weight: var(--fw-bold);
        line-height: 1.3;
        letter-spacing: -0.01em;
      }

      .cl-topic .cl-shot,
      .cl-topic .cl-carousel {
        margin-bottom: 14px;
      }

      .cl-entry--highlight {
        scroll-margin-top: 16px;
      }

      .cl-tag--new {
        color: var(--accent);
      }

      .cl-hl-prs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 14px 0 0;
      }

      .cl-pr {
        display: inline-block;
        padding: 1px 7px;
        margin-left: 4px;
        border: 1px solid var(--border-panel);
        border-radius: var(--radius-pill);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: var(--fs-mono);
        line-height: 1.6;
        white-space: nowrap;
        vertical-align: 1px;
      }

      .cl-hl-prs .cl-pr {
        margin-left: 0;
      }

      .cl-pr:hover {
        border-color: var(--accent-solid);
      }

      /* Screenshot: every image in one 16:9 frame, a highlight drawn over it */
      .cl-shot {
        margin: 18px 0 0;
      }

      .cl-frame {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background:
          radial-gradient(circle, rgba(167, 139, 250, 0.06) 1px, transparent 1px) 0 0 / 22px 22px,
          #120f22;
        border: 1px solid var(--border-panel);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-figure);
      }

      .cl-frame-image {
        position: absolute;
        display: block;
        overflow: hidden;
      }

      .cl-frame-image img {
        display: block;
        width: 100%;
        height: 100%;
      }

      .cl-mark {
        position: absolute;
        border: 2px solid var(--accent);
        border-radius: 10px;
        box-shadow:
          0 0 0 4px rgba(167, 139, 250, 0.22),
          0 0 0 100vmax var(--scrim);
        pointer-events: none;
      }

      .cl-shot figcaption {
        margin-top: 10px;
        color: var(--text-body);
        font-size: var(--fs-ui-sm);
        line-height: var(--lh-ui);
      }

      /* Carousel */
      .cl-carousel {
        margin-top: 18px;
      }

      .cl-track {
        display: flex;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        border-radius: var(--radius-md);
      }

      .cl-track::-webkit-scrollbar {
        display: none;
      }

      @media (prefers-reduced-motion: no-preference) {
        .cl-track {
          scroll-behavior: smooth;
        }
      }

      .cl-slide {
        flex: 0 0 100%;
        min-width: 0;
        margin: 0;
        scroll-snap-align: start;
      }

      .cl-slide .cl-frame {
        box-shadow: none;
      }

      .cl-carousel-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-top: 12px;
      }

      .cl-car-btn {
        display: inline-grid;
        place-items: center;
        width: 36px;
        height: 36px;
        background: none;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-pill);
        color: var(--text-primary);
        font-size: var(--fs-ui);
        cursor: pointer;
      }

      .cl-car-btn:hover:not(:disabled) {
        border-color: var(--accent-solid);
      }

      .cl-car-btn:disabled {
        opacity: 0.35;
        cursor: default;
      }

      .cl-dots {
        display: flex;
        gap: 4px;
      }

      .cl-dot {
        position: relative;
        width: 24px;
        height: 24px;
        padding: 0;
        background: none;
        border: 0;
        cursor: pointer;
      }

      .cl-dot::after {
        content: '';
        position: absolute;
        inset: 8px;
        border-radius: var(--radius-pill);
        background: var(--border-strong);
      }

      .cl-dot[aria-current='true']::after {
        background: var(--accent);
      }

      /* Also in this release */
      .cl-body {
        margin-top: 28px;
        border-top: 1px solid var(--rule);
      }

      .cl-also-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 0 4px;
        cursor: pointer;
        list-style: none;
      }

      .cl-also-head::-webkit-details-marker {
        display: none;
      }

      .cl-also-title {
        color: var(--text-primary);
        font-size: var(--fs-ui);
        font-weight: var(--fw-bold);
      }

      .cl-also-count {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--fs-mono);
      }

      .cl-chevron {
        width: 8px;
        height: 8px;
        margin-left: auto;
        flex-shrink: 0;
        border-right: 1.5px solid var(--text-muted);
        border-bottom: 1.5px solid var(--text-muted);
        transform: rotate(45deg);
        transition: transform 0.15s ease;
      }

      details[open] > .cl-also-head .cl-chevron {
        transform: rotate(-135deg);
      }

      @media (prefers-reduced-motion: reduce) {
        .cl-chevron {
          transition: none;
        }
      }

      .cl-group {
        margin-top: 16px;
      }

      .cl-group-label {
        margin: 0 0 6px;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--fs-micro);
        font-weight: var(--fw-medium);
        letter-spacing: var(--ls-eyebrow-sm);
        text-transform: uppercase;
      }

      .cl-entries {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .cl-entry {
        display: grid;
        grid-template-columns: 64px minmax(0, 1fr);
        gap: 12px;
        padding: 7px 0;
        border-top: 1px solid rgba(29, 25, 48, 0.7);
      }

      .cl-entry:first-child {
        border-top: 0;
      }

      .cl-tag {
        padding-top: 3px;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--fs-micro);
        letter-spacing: var(--ls-chip);
        text-transform: uppercase;
      }

      .cl-tag--added {
        color: var(--tag-added);
      }

      .cl-tag--fixed {
        color: var(--tag-fixed);
      }

      .cl-tag--security,
      .cl-tag--breaking {
        color: var(--tag-security);
      }

      .cl-entry-line {
        color: var(--text-primary);
        font-size: var(--fs-ui);
        line-height: var(--lh-ui);
      }

      .cl-entry-line strong {
        font-weight: var(--fw-semibold);
      }

      .cl-say {
        color: var(--text-body);
      }

      /* A marker stroke over the lower part of the line, in the accent hue. */
      .cl-hi {
        padding: 0 0.12em;
        margin: 0 -0.12em;
        background: linear-gradient(
          to bottom,
          transparent 30%,
          color-mix(in srgb, var(--accent) 38%, transparent) 30%,
          color-mix(in srgb, var(--accent) 26%, transparent) 92%,
          transparent 92%
        );
        border-radius: 0.3em 0.15em 0.35em 0.2em;
        color: var(--text-primary);
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
      }

      .cl-more {
        margin-top: 2px;
      }

      .cl-more > summary {
        width: fit-content;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--fs-mono);
        cursor: pointer;
      }

      .cl-more > summary:hover {
        color: var(--accent);
      }

      .cl-more > .cl-prose {
        margin-top: 6px;
        color: var(--text-body);
        font-size: var(--fs-ui-sm);
      }

      /* Prose, as written in the source files */
      .cl-prose {
        line-height: var(--lh-ui);
        overflow-wrap: break-word;
      }

      .cl-prose ul,
      .cl-prose ol {
        margin: 6px 0;
        padding-left: 18px;
      }

      .cl-prose li + li {
        margin-top: 6px;
      }

      .cl-prose p {
        margin: 0 0 8px;
      }

      .cl-prose p:last-child {
        margin-bottom: 0;
      }

      .cl-prose strong {
        color: var(--text-primary);
        font-weight: var(--fw-bold);
      }

      .cl-prose blockquote {
        margin: 8px 0;
        padding-left: 14px;
        border-left: 1px solid var(--rule);
      }

      .cl-prose pre {
        max-width: 100%;
        margin: 10px 0;
        padding: 12px 16px;
        overflow-x: auto;
        border: 1px solid var(--rule);
        border-radius: var(--radius-button-sm);
        font-size: var(--fs-mono);
        line-height: 1.6;
      }

      .cl-prose pre code {
        color: inherit;
        overflow-wrap: normal;
      }

      .cl-prose table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
      }

      .cl-prose th,
      .cl-prose td {
        padding: 6px 12px;
        border: 1px solid var(--rule);
        text-align: left;
      }

      .cl-prose img {
        max-width: 100%;
        height: auto;
      }

      /* Foot */
      .cl-foot {
        padding: 48px;
        border-top: 1px solid var(--rule);
      }

      .cl-foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--fs-mono);
      }

      @media (max-width: 700px) {
        .cl-nav,
        .cl-head,
        .cl-filters,
        .cl-unreleased,
        .cl-released,
        .cl-foot {
          padding-left: 16px;
          padding-right: 16px;
        }

        .cl-unreleased,
        .cl-released {
          padding-top: 40px;
          padding-bottom: 40px;
        }

        .cl-release {
          padding: 18px 16px;
        }

        .cl-filters {
          gap: 8px;
        }

        .cl-filters .cl-filter:first-child {
          flex: 1 1 auto;
          min-width: 0;
        }

        .cl-pill {
          padding: 3px 8px;
        }

        .cl-pill-more {
          display: none;
        }

        .cl-area {
          padding: 4px 10px;
          font-size: var(--fs-mono);
        }

        .cl-entry {
          grid-template-columns: minmax(0, 1fr);
          gap: 2px;
        }

        .cl-tag {
          padding-top: 0;
        }

        .cl-hl-title {
          font-size: 18px;
        }
      }
    </style>
  </body>
</html>
