  "last_action": "implement completed",
  "intent": "Let a Teamboard member set their own profile photo, and make a bad file fail loudly instead of quietly.",
  "approach": "One endpoint, one storage write, one column swap, one control on the profile page. Validation runs before anything touches storage.",
  "expectations": [
    "Cropping, filters, and rotation. The server centre-crops.",
    "Admin bulk upload.",
    "Any third-party avatar source."
  ],
  "context": [
    "constraint: Only the member can change their own photo. No admin path.",
    "constraint: A failed delete may orphan an object. It must never lose a photo.",
    "area: src/api avatar service and the profile page",
    "The CSV export thumbnailer already depends on sharp 0.33.",
    "Express 5 exposes content length before the body is buffered.",
    "The avatars bucket already has a weekly orphan sweep."
  ],
  "decisions": [
    {
      "decision": "Resize on the server, not in the browser.",
      "why": "Two phones produce two different images from the same file. The server is the only place a 256 by 256 square is guaranteed.",
      "rejected": "Client-side canvas resize before upload"
    },
    {
      "decision": "Reject before reading the body.",
      "why": "Content length is known up front, so a 500 MB file costs nothing.",
      "rejected": "Buffer the upload first, then check its size"
    },
    {
      "decision": "Swap avatar_url first, delete the old object second.",
      "why": "A failed delete leaves an orphan the weekly sweep collects. The other order loses a photo.",
      "rejected": "Delete the previous object before the swap"
    }
  ],
