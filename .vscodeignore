# Dev workspace — never runtime code (vsce ignores .gitignore when this file exists,
# so gitignored caches/build output must be listed here too)
.codex/**
examples/**
specs/**
bench/**
# The marketing/docs site. Separate package.json, separate lockfile, separate
# deploy. Its node_modules and dist would otherwise land in the .vsix, since
# vsce ignores .gitignore whenever this file exists.
website/**
speckit-extension/**
# Ship the context writer inside the .vsix: the stock-mode prompt preamble
# references it by the extension's install path (see promptBuilder).
# Its sibling modules ship too — the writer imports them at startup.
!speckit-extension/scripts/write-context.py
!speckit-extension/scripts/spec_context.py
!speckit-extension/scripts/spec_deltas.py
!speckit-extension/scripts/capture.py
!speckit-extension/scripts/task_sync.py
!speckit-extension/scripts/living_spec_fold.py
!speckit-extension/scripts/run_trace.py
# The shared atomic-write helper. The capture writers publish through it; each
# guards the import and falls back to its old fixed-`.tmp` write, so leaving it
# out would silently downgrade the crash-safety guarantee rather than fail loudly
# — which is exactly the kind of quiet regression it exists to prevent.
!speckit-extension/scripts/companion_config.py
# The pipeline builder runs these against the extension's own node sources, so a
# project consuming the extension can build and draw its pipeline without a
# separate install. Leaving them out ships a panel that can only say it is
# unavailable — the "contributed but unreachable" failure this repo keeps fixing.
!speckit-extension/scripts/build-pipeline.py
!speckit-extension/scripts/pipeline-graph.py
!speckit-extension/scripts/config_write.py
!speckit-extension/scripts/config_repair.py
!speckit-extension/scripts/hook_render.py
!speckit-extension/scripts/template_render.py
!speckit-extension/scripts/decision_routes.py
!speckit-extension/scripts/manifest.py
!speckit-extension/scripts/assemble-nodes.py
!speckit-extension/scripts/instruction-budget.py
!speckit-extension/scripts/_command_parts.py
# …and the sources they assemble from.
!speckit-extension/nodes/**
!speckit-extension/presets/_parts/**
!speckit-extension/fragments/**
!speckit-extension/workflows/presets/**
