{
  // The CommonJS build for runtimes that cannot load TypeScript: the extension host's
  // development launch and plain Node. No DOM lib, so a DOM API in /core fails the build.
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2022"],
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "declaration": false,
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["**/__tests__/**"]
}
