{
  "name": "speckit-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "The SpecKit Companion spec viewer: contract, core and styles, shared by the extension and other hosts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfredoperez/speckit-companion",
    "directory": "packages/viewer"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "LICENSE",
    "README.md",
    "!**/__tests__"
  ],
  "exports": {
    "./contract": {
      "types": "./src/contract/index.ts",
      "source": "./src/contract/index.ts",
      "default": "./dist/contract/index.js"
    },
    "./contract/*": {
      "types": "./src/contract/*.ts",
      "source": "./src/contract/*.ts",
      "default": "./dist/contract/*.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "source": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./src/core/*.ts",
      "source": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "./view": {
      "types": "./src/view/index.ts",
      "source": "./src/view/index.ts"
    },
    "./view/*": {
      "types": "./src/view/*.ts",
      "source": "./src/view/*.ts"
    },
    "./element": {
      "types": "./dist/types/element/index.d.ts",
      "source": "./src/element/index.ts",
      "import": "./dist/element/index.js",
      "default": "./dist/element/index.js"
    },
    "./styles/*": "./dist/styles/*"
  },
  "typesVersions": {
    "*": {
      "contract": [
        "src/contract/index.ts"
      ],
      "contract/*": [
        "src/contract/*"
      ],
      "core": [
        "src/core/index.ts"
      ],
      "core/*": [
        "src/core/*"
      ],
      "view": [
        "src/view/index.ts"
      ],
      "view/*": [
        "src/view/*"
      ],
      "element": [
        "dist/types/element/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.view.json && node scripts/build-css.mjs && node scripts/build-element.mjs"
  },
  "dependencies": {
    "@preact/signals": "^1.3.4",
    "highlight.js": "11.9.0",
    "preact": "^10.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "postcss": "^8.5.26",
    "esbuild": "^0.28.2"
  }
}
