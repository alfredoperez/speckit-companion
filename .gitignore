node_modules/
dist/
out/
*.vsix
.vscode-test/
*.log
.DS_Store
.env

# SDD implement write-ahead journal — transient, materialized into .spec-context.json
.spec-context.events.jsonl
.spec-context.events.lock

# Run self-trace — local diagnostic read only by the doctor, size-capped, never committed.
# The doctor's own test fixtures ship a hand-written trace and are the one exception.
.trace.jsonl
!speckit-extension/tests/fixtures/**/.trace.jsonl

# Bench: per-style sandbox templates + ephemeral run cells (regenerated by bench/sync-templates.mjs)
examples/bench-sandboxes/
.env.local
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json



# 测试相关
coverage/
*.snap.tmp
.nyc_output/

# Storybook build output (regenerated by `npm run build-storybook`)
storybook-static/

# Serena MCP per-project cache (machine-generated, includes large .pkl dumps)
.serena/

# Transient prompt artifact written by the SpecKit Companion extension at dispatch
.claude/speckit-companion-prompt.md

# Local dev-install artifacts from `specify extension add ./speckit-extension --dev`
# (machine-specific symlinks + caches; the source of truth is speckit-extension/)
.specify/extensions/**/.specify-dev/
.specify/extensions/.cache/
# Generated companion install output — the installed copy of speckit-extension/
# plus the per-agent command emissions. Regenerated by the `--dev` install on
# every machine; never hand-edited. (The non-companion `specify init --ai`
# scaffolding under these dirs stays tracked as IDE-chat test fixtures.)
.specify/extensions/companion/
# Locally-installed preset copies + catalog cache/registry from `specify preset
# add --dev` (source of truth is speckit-extension/presets/; never hand-edited).
.specify/presets/
.claude/skills/speckit-companion-*/
.cursor/skills/speckit-companion-*/
.agents/skills/speckit-companion-*/
.gemini/commands/speckit.companion.*
.qwen/commands/speckit.companion.*
.github/agents/speckit.companion.*
.github/prompts/speckit.companion.*
.windsurf/workflows/speckit.companion.*

# Website build artifacts (website/ has its own package.json and lockfile; the
# lockfile itself stays tracked so Vercel can `npm ci`)
website/node_modules/
website/dist/
website/.astro/
website/.vercel/

# Local-only demo spec dirs (underscore-prefixed under specs/)
specs/_*/

# Canonical demo testing specs are committed at a fixed baseline (specified /
# planned / tasked-out states). They are tracked, but local edits must NOT be
# committed — see CLAUDE.md "Demo testing specs". Revert with `git restore`.
!specs/_demo-specified/
!specs/_demo-planned/
!specs/_demo-tasked/
!specs/_00_demo-specified/
!specs/_01_demo-planned/
!specs/_02_demo-tasked/
!specs/_03_demo-living/

# The seeded design-canvas payload (~2MB of editor). The .dc.html artboards it
# is built from are the sources and stay tracked.
/design/pipeline-builder-redesign.html
webview/src/pipeline-builder/__screenshots__/diff/
# Third-party skills installed by `npx skills add`, which writes into the repo
# rather than the home directory. They are tooling for whoever is working here,
# not part of either shipped extension, and .agents/ and .claude/ are otherwise
# committed manual-testing fixtures — so ignore these by name instead of
# loosening the rules that keep those fixtures tracked.
.agents/skills/higgsfield-*/
.claude/skills/higgsfield-*
