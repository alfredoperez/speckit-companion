---
/**
 * The landing page.
 *
 * Structure and visual treatment are ported from the approved Constellation
 * artboard. Every value comes from the token sheet via src/styles/tokens.css,
 * or is a one-off the sheet explicitly said not to promote, kept literal here
 * with a comment saying so.
 *
 * Copy: every sentence traces to a row in the claim ledger. The three places
 * the artboard's own copy brushed a never-say entry are corrected here, marked
 * "ledger:" where they sit.
 *
 * Media: clip and still paths are read out of media/manifest.json and mapped
 * onto the site's public URL prefix. Nothing is hand-written, and a feature the
 * manifest has not shipped yet falls back to one that has.
 */
import BaseLayout from '../components/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Button from '../components/Button.astro';
import CodeLine from '../components/CodeLine.astro';
import manifest from '../../../media/manifest.json';

const MARKETPLACE = 'https://marketplace.visualstudio.com/items?itemName=alfredoperez.speckit-companion';
const OPEN_IN_VSCODE = 'vscode:extension/alfredoperez.speckit-companion';
const METHODOLOGY =
  'https://github.com/alfredoperez/speckit-companion/blob/main/docs/configuration.md';

// The full --from URL form, verbatim. The short catalog form does not work:
// the extension is not listed in the spec-kit catalog.
const INSTALL_COMMAND =
  'specify extension add companion --from https://github.com/alfredoperez/speckit-companion/releases/download/companion-latest/companion.zip --force';

type Feature = {
  id: string;
  status: string;
  outputs: Record<string, string | null>;
  alt?: Record<string, string>;
};

const features = manifest.features as Feature[];
const sourceDir = manifest.site.sourceDir;
const urlPrefix = manifest.site.publicUrlPrefix;

/** A repo-relative manifest path becomes the URL the site serves it from. */
function siteUrl(rel: string | null | undefined): string | null {
  if (!rel) return null;
  if (!rel.startsWith(`${sourceDir}/`)) {
    throw new Error(`${rel} is outside ${sourceDir}/, so the site cannot serve it`);
  }
  return urlPrefix + rel.slice(sourceDir.length);
}

function media(id: string) {
  const feature = features.find((entry) => entry.id === id);
  if (!feature) throw new Error(`media/manifest.json has no feature "${id}"`);
  const poster = siteUrl(feature.outputs.poster);
  const panel = siteUrl(feature.outputs.panelStill);
  return {
    id,
    webm: siteUrl(feature.outputs.webWebm),
    mp4: siteUrl(feature.outputs.webMp4),
    poster,
    panel,
    panelAlt: (feature.outputs.panelStill && feature.alt?.[feature.outputs.panelStill]) || '',
    alt: (feature.outputs.poster && feature.alt?.[feature.outputs.poster]) || '',
    ready:
      feature.status === 'shipped' && Boolean(feature.outputs.webWebm && feature.outputs.webMp4 && poster),
  };
}

const overview = media('overview');
const makeItYours = media('make-it-yours');

// review runs the review surface through all four of its states and then closes
// on the side bar, so the tab shows where you would go looking for that spec
// later rather than stopping at the comment.
const review = media('review');

// The Living Specs tab and the accordion figure both play the drawn explainer
// rather than a screenshot tour. A tour can only show the tree; the argument is
// what the tree replaces, and that needs a diagram.
const livingExplained = media('living-specs-explained');

/*
  The hero stills. Built by scripts/build-hero-stills.mjs, which crops them out
  of the clip compositions' own DPR-2 source captures, so a palette change is a
  re-shoot plus a re-run and the hero can never drift from what the clips show.

  Captions carry the benefit, not the feature name: someone who reads only the
  hero should still learn what the product is for. Each one is a cleared claim —
  the Overview one avoids a flat timing claim, and the Review one says the note
  is sent rather than applied, because Refine dispatches a request and never
  reads the file back.
*/
/*
  The ambient chips drifting around the hero. Every string is one the product
  actually renders — a coverage count, a drift flag, a comment state, a phase
  timing — so the field teaches the vocabulary before anyone clicks. Positions
  are hand-placed to sit clear of the frame in the middle.
*/
const motes = [
  { text: '6/6 traced', x: -6, y: 8, dx: 12, dy: -10, dur: 9200, delay: 0 },
  { text: 'drift', x: 87, y: -1, dx: -9, dy: 12, dur: 10400, delay: 900 },
  { text: 'PENDING', x: 93, y: 34, dx: -13, dy: -8, dur: 8600, delay: 1800 },
  { text: '54m 36s elapsed', x: -9, y: 56, dx: 10, dy: 11, dur: 11200, delay: 600 },
  { text: '{ } capability', x: 86, y: 86, dx: -11, dy: -12, dur: 9800, delay: 2400 },
  { text: 'APPLIED', x: -3, y: 92, dx: 13, dy: -9, dur: 10100, delay: 1400 },
];

/*
  The focal light a product frame sits in front of. Painted by
  scripts/build-lightwell.mjs, not drawn in CSS: a large low-alpha gradient over
  near-black bands, and the stars have to be there when motion is off.
*/
const lightwell = (() => {
  const f = features.find((entry) => entry.id === 'page-lightwell');
  if (!f) throw new Error('media/manifest.json has no feature "page-lightwell"');
  return {
    hero: siteUrl(f.outputs.lightwellHero),
    section: siteUrl(f.outputs.lightwellSection),
  };
})();

const surfaces = [
  {
    id: 'overview',
    label: 'Overview',
    src: `${urlPrefix}/hero-overview.png`,
    caption: 'The whole run on one page: what it was for, what it decided, and what traced to a test.',
    alt: 'The Overview of a finished run: the intent it answers to, the four phases with the time each took, the approach, and the corner of the codebase it changed.',
  },
  {
    id: 'living',
    label: 'Living Specs',
    src: `${urlPrefix}/hero-living-specs.png`,
    caption: 'What you learned, kept next to the code it describes.',
    alt: 'The Living Specs tree: capabilities kept at a root and beside the code in features, jobs and services, each row carrying its coverage count or a drift flag.',
  },
  {
    id: 'review',
    label: 'Review',
    src: `${urlPrefix}/hero-review.png`,
    caption: 'Comment on the line. Refine sends the note to your agent.',
    alt: 'Two review comments pinned under a requirement, the second one open with its Refine, Edit and Delete actions.',
  },
];

/*
  Each tab states its point before its clip plays, because a clip cannot argue
  and a label cannot explain. Every sentence here traces to a cleared row in the
  claim ledger; three phrasings are deliberate and should not be "improved":
  timing is only reported where both ends were recorded, hook attachments are
  instructions the assistant reads rather than an engine that runs them, and
  Refine dispatches a request rather than applying an edit.
*/
const tabs = [
  {
    id: 'understand',
    label: 'Understand',
    window: 'Overview · the run’s story',
    heading: 'You stop reading four markdown files',
    body: 'A finished run becomes one page: what it was for, how it was approached, where in the codebase it landed, and what it decided against — with a coverage table that puts untraced requirements first.',
    clip: overview,
  },
  {
    id: 'customize',
    label: 'Customize',
    window: 'Custom workflows · the one you wrote, at every step',
    heading: 'The workflow is yours, not the tool’s',
    body: 'Define your own phases, commands and output files in settings, and attach a shell command, an inline instruction, or a node file of your own before or after any named step. Those attachments are instructions your assistant reads at run time.',
    clip: makeItYours,
  },
  {
    id: 'living',
    label: 'Living specs',
    window: 'Living Specs · what outlives the ticket',
    heading: 'The learning outlives the ticket',
    body: 'Spec Kit leaves each spec in a folder that goes quiet when the feature ships. Turn living specs on and every capability keeps one durable spec instead — at the root, or next to the code it describes.',
    clip: livingExplained,
  },
  {
    id: 'review',
    label: 'Review',
    window: 'Review · a comment under the line it annotates',
    heading: 'Say it in the margin, not in the chat box',
    body: 'Comment on a line the way you’d review a pull request. Notes persist the moment you add them, and Refine sends the pending ones to your agent as an in-place edit request.',
    clip: review,
  },
];

/*
  Living specs leads, because it is the row nothing else in this category has.
  Order is the literal array order: it is consumed twice, once for the toggles
  and once for the stacked stills, so moving an entry moves both.
*/
const rows = [
  {
    id: 'living',
    title: 'Specs that outlive the ticket',
    body: 'Spec Kit writes the spec, ships the feature, and leaves the folder behind. What you learned about how that capability works goes quiet with it. Turn living specs on and each capability keeps one durable spec instead — at capabilities/<name>/spec.md, or next to the code with a path you choose. Drift lists the source files that changed since a capability’s spec was last committed. Drift and coverage are read-only reports that always exit zero, so neither can block a build.',
    link: { label: 'living specs', href: '/docs/guides/living-specs/' },
    still: livingExplained,
    open: true,
  },
  {
    id: 'read',
    title: 'Runs you can read',
    body: 'A finished run becomes a page. It leads with the intent, the approach and the area worked in, fences the constraints against the declared non-goals, and lists each decision with what it rejected. The coverage table traces every requirement to the tasks that delivered it and the tests that exercise it, and untraced requirements sort to the top.',
    link: { label: 'read the Overview guide', href: '/docs/anatomy/anatomy-of-the-overview/' },
    still: overview,
  },
  {
    id: 'bend',
    title: 'A pipeline you can bend',
    body: 'Two workflows ship in the box: stock SpecKit, and SpecKit Companion with a fifth step that marks the spec complete. Define your own phases, commands and output files in settings and Create Spec offers them. A companion.yml attaches a shell command, an inline instruction, or a node file of your own before or after any named node. Those attachments are instructions your assistant reads at run time, not an engine that executes them.',
    link: { label: 'pick a pipeline', href: '/docs/guides/pick-a-pipeline/' },
    still: makeItYours,
  },
  {
    id: 'review',
    title: 'Reviews with a reply button',
    body: 'Comment on a line of a spec, the way you’d review a pull request. Your notes persist the moment you add them, and Refine sends the pending ones to your agent, so you’re not copy-pasting into a chat box. The sidebar keeps every spec and its status one click away.',
    link: { label: 'explore the review flow', href: '/docs/guides/review-and-refine/' },
    still: review,
  },
];

const cards = [
  {
    eyebrow: 'OVERVIEW',
    title: 'Runs you can read',
    // ledger: "the command that proved it" implies re-execution. Nothing re-runs.
    body: 'A finished run becomes a page: the intent, the fence around the work, and each check with the command it ran and the result it reported.',
  },
  {
    eyebrow: 'LIVING SPECS',
    title: 'One spec per capability',
    // ledger: living specs do not update themselves, and they are opt-in.
    body: 'Register a capability and it gets a durable spec. When a run authors its deltas at completion, a script folds them in, and prints a receipt when a capability ends with neither a delta nor a skip note.',
  },
  {
    eyebrow: 'REVIEW',
    title: 'Comments that travel',
    body: 'Line-level review, PR style. Comments persist as you add them and survive a tab close, and Refine hands the pending ones to your agent.',
  },
  {
    eyebrow: 'LIVE · RECORD',
    title: 'Watch it run, keep the record',
    body: 'Phases and timing while the agent works, and every step written to one committable file. Grep it, diff it, commit it with the branch.',
  },
  {
    eyebrow: 'PIPELINE',
    title: 'A pipeline you can bend',
    body: 'Two workflows ship in the box, and the workflow a spec was created with drives every dispatch. Define your own phases, commands and output files in settings and Create Spec offers them.',
  },
  {
    eyebrow: 'PROVIDERS',
    // ledger: "any agent can drive it" is a never-say. Three of the eleven
    // cannot submit for you.
    title: 'Eleven providers',
    body: 'Terminal CLIs, IDE chat, the Claude Code panel. The extension hands your assistant the command text, then reads what lands on disk. Not every provider supports every piece.',
  },
];

// One leaf per section below the hero, in document order. The script measures
// where each section boundary falls and places its leaf on the stem; a leaf
// with no section to mark stays hidden.
const stemLeaves = ['quick start', 'demo', 'features', 'box', 'claim', 'install'];

// Entrances stagger at 60ms. The delay is data, not a magic number in the CSS.
const REVEAL_STAGGER = 60;

// Bioluminescent spores: slow points of light drifting under the content, in
// the palette's purple and its leaf green. Each one carries its own place,
// drift vector, period and a negative delay, so the field is already mid-drift
// on the first frame and no two points ever fall into phase. The values are
// hand-placed rather than generated, because the page renders on the server and
// the same page has to come back twice.
//
// `bright` scales the point's peak opacity, so a field reads as depth rather
// than as one layer of identical dots. It is optional: left off, the point
// burns at the keyframe's own alpha.
type Spore = {
  x: number;
  y: number;
  size: number;
  dx: number;
  dy: number;
  dur: number;
  delay: number;
  bright?: number;
  tone?: 'green';
};

const spores: Record<'hero' | 'accordion' | 'cards', Spore[]> = {
  // The hero's field is the densest of the three and it is not spread evenly:
  // most of it gathers in the upper middle, around and above the mascot, and
  // thins out towards the edges and the floor. That is what makes it read as a
  // clearing with something glowing in it rather than as weather. Every period
  // and every delay below is distinct, so nothing ever falls into step.
  hero: [
    // the clearing itself: around and above the mascot
    { x: 46, y: 27, size: 5, dx: 14, dy: -46, dur: 15700, delay: -2300, bright: 1 },
    { x: 57, y: 19, size: 3, dx: -11, dy: -34, dur: 19300, delay: -8900, bright: 0.75, tone: 'green' },
    { x: 39, y: 14, size: 4, dx: 17, dy: -40, dur: 17300, delay: -13100, bright: 0.9 },
    { x: 62, y: 33, size: 6, dx: -19, dy: -52, dur: 23900, delay: -5900, bright: 1.15 },
    { x: 51, y: 9, size: 2, dx: 9, dy: -26, dur: 12700, delay: -10300, bright: 0.6, tone: 'green' },
    { x: 34, y: 31, size: 3, dx: 13, dy: -38, dur: 21100, delay: -17700, bright: 0.8 },
    { x: 68, y: 12, size: 4, dx: -15, dy: -30, dur: 18100, delay: -3700, bright: 0.95, tone: 'green' },
    { x: 44, y: 38, size: 5, dx: -12, dy: -58, dur: 25300, delay: -20900, bright: 1.05 },
    // the treeline: fewer, dimmer, further out
    { x: 12, y: 62, size: 4, dx: 20, dy: -56, dur: 22300, delay: -6700, bright: 0.85 },
    { x: 22, y: 44, size: 3, dx: -10, dy: -36, dur: 16100, delay: -14900, bright: 0.7, tone: 'green' },
    { x: 81, y: 57, size: 5, dx: 18, dy: -62, dur: 26900, delay: -9700, bright: 0.9 },
    { x: 90, y: 36, size: 3, dx: -14, dy: -28, dur: 14300, delay: -4100, bright: 0.65 },
    { x: 71, y: 79, size: 4, dx: -21, dy: -50, dur: 24100, delay: -18300, bright: 0.8, tone: 'green' },
    { x: 29, y: 84, size: 5, dx: 16, dy: -60, dur: 27700, delay: -11300, bright: 0.75 },
  ],
  accordion: [
    { x: 6, y: 78, size: 4, dx: 14, dy: -44, dur: 27100, delay: -3700 },
    { x: 44, y: 92, size: 3, dx: -18, dy: -36, dur: 13900, delay: -16300, tone: 'green' },
    { x: 88, y: 62, size: 4, dx: -20, dy: -52, dur: 25300, delay: -7100 },
    { x: 71, y: 18, size: 3, dx: 12, dy: -26, dur: 18700, delay: -12900 },
  ],
  cards: [
    { x: 14, y: 86, size: 4, dx: 20, dy: -50, dur: 22300, delay: -1900, tone: 'green' },
    { x: 55, y: 22, size: 3, dx: -14, dy: -32, dur: 16100, delay: -21100 },
    { x: 93, y: 70, size: 4, dx: -22, dy: -46, dur: 24700, delay: -9500 },
  ],
};
---

<BaseLayout
  title="SpecKit Companion"
  description="A spec workspace inside VS Code. It turns markdown specs into pages worth reading, shows every run while it happens, and sends your review notes back to the agent without a copy-paste."
  nav={false}
  footer={false}
>
  {/* Runs during parse, before the hero paints, so a resting state never
      flashes into view and then hides itself. Motion is opt-in twice over:
      scripting has to be on, and the visitor must not have asked for less. */}
  <script is:inline>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.setAttribute('data-motion', '');
    }
  </script>

  {/* The stem. A vine down the left gutter whose height is scroll position,
      sprouting a leaf at each section boundary as that section passes. */}
  <div class="stem" data-stem aria-hidden="true">
    <span class="stem-rail"></span>
    <span class="stem-vine" data-stem-vine></span>
    {
      stemLeaves.map((name) => (
        <span class="stem-leaf" data-stem-leaf={name}>
          <svg viewBox="0 0 16 14" width="14" height="13" fill="none">
            <path class="leaf-stalk" d="M1.8 7.6 5 11.2" />
            <path class="leaf-blade" d="M5 11.4C4 6.9 7.7 2.7 13.6 1.6 14.3 6.9 10.7 11 5 11.4Z" />
          </svg>
        </span>
      ))
    }
  </div>

  <!-- HERO -->
  <section class="hero">
    <SiteNav installHref="#quick-start" />

    {/* Bigger points get a softer edge, so the field has depth instead of one
        uniform dot size. The blur follows the size rather than being placed by
        hand, because the two only ever move together. */}
    <div class="spores" aria-hidden="true">
      {
        spores.hero.map((spore) => (
          <span
            class="spore"
            data-tone={spore.tone}
            style={`--sx:${spore.x}%;--sy:${spore.y}%;--ss:${spore.size}px;--sdx:${spore.dx}px;--sdy:${spore.dy}px;--sdur:${spore.dur}ms;--sdelay:${spore.delay}ms;--sb:${spore.bright ?? 1};--sblur:${(spore.size * 0.32).toFixed(2)}px`}
          />
        ))
      }
    </div>

    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow eyebrow--hero">OPEN SOURCE · RUNS IN YOUR EDITOR</p>

        <h1>
          Spec-driven development,<br />
          one <em>level</em> up.
        </h1>

        <p class="lead">
          Read a run instead of a folder. Keep what you learned instead of archiving it. Send your
          review notes back to your agent by writing in the margin, not by re-prompting from
          scratch.
        </p>

        <p class="ownership">Your specs. Your pipeline. Your record. Your repo.</p>

        <div class="hero-actions">
          <Button
            href={MARKETPLACE}
            external
            size="lg"
            data-analytics="install_click_vscode"
            data-analytics-placement="hero"
          >
            Install for VS Code
          </Button>
          <Button href="/docs/" variant="secondary" size="lg">Read the docs</Button>
        </div>
      </div>

      {/* The product, in the first screenful. Three surfaces cycle in one frame
          with a caption that changes with them, so someone who never scrolls
          still learns what this is.

          The stills are crops, not whole windows: a full IDE shrunk into this
          column is unreadable, which is the reason the hero used to be words.
          Same crossfade the accordion uses. Under reduced motion nothing
          cycles, surface one shows, and all three buttons still work. */}
      <div class="hero-show" data-hero-show>
        <div class="hero-orbit">
          {/* Ambient chips. They are real strings from the product, not filler:
              a visitor reading them picks up the vocabulary before they have
              clicked anything. Decorative to a screen reader. */}
          <div class="hero-motes" aria-hidden="true">
            {
              motes.map((mote) => (
                <span
                  class="mote"
                  style={`--mx:${mote.x}%;--my:${mote.y}%;--mdx:${mote.dx}px;--mdy:${mote.dy}px;--mdur:${mote.dur}ms;--mdelay:${mote.delay}ms`}
                >
                  {mote.text}
                </span>
              ))
            }
          </div>

          <div class="hero-stagebox">
            <img
              class="lightwell lightwell--hero"
              data-hero-bloom
              src={lightwell.hero}
              alt=""
              aria-hidden="true"
              width="2400"
              height="1360"
              fetchpriority="high"
            />
            <div class="hero-stage">
            {
              surfaces.map((surface, index) => (
                <img
                  class="hero-shot"
                  data-hero-shot={surface.id}
                  data-active={index === 0 ? '' : undefined}
                  src={surface.src}
                  alt={surface.alt}
                  width="1600"
                  height="1014"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  />
                ))
              }
            </div>
          </div>
        </div>

        {/* The chips are the only naming the hero has now: no fake window title,
            no caption line under the frame. The one you pick stays lit and its
            sentence surfaces inside the bloom for a beat as the shot arrives. */}
        <div class="hero-pips" role="tablist" aria-label="Product surfaces">
          {
            surfaces.map((surface, index) => (
              <button
                type="button"
                class="hero-pip"
                role="tab"
                data-hero-pip={surface.id}
                data-hero-caption={surface.caption}
                style={`--pdur:${5200 + index * 900}ms;--pdelay:${index * 700}ms`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                {surface.label}
              </button>
            ))
          }
        </div>

        <p class="hero-flash" data-hero-flash aria-live="polite">{surfaces[0].caption}</p>
      </div>
    </div>
  </section>

  <!-- QUICK START -->
  <section class="section section--quickstart" id="quick-start">
    <div class="inner stack-16">
      <p class="eyebrow">QUICK START</p>

      <div class="steps" data-steps>
        <span class="spark" data-spark aria-hidden="true"></span>

        <div class="step" data-step>
          <span class="step-flare" aria-hidden="true"></span>
          <span class="step-num" aria-hidden="true">01</span>
          <div class="step-text">
            <span class="step-title">Install the VS Code extension</span>
            <span class="step-sub">
              The workspace: viewer, review, live runs, overview. One click from the Marketplace.
            </span>
          </div>
          <Button
            class="step-action"
            href={OPEN_IN_VSCODE}
            size="md"
            data-analytics="install_click_vscode"
            data-analytics-placement="quick-start"
          >
            Open in VS Code
          </Button>
        </div>

        <div class="step" data-step>
          <span class="step-flare" aria-hidden="true"></span>
          <span class="step-num" aria-hidden="true">02</span>
          <div class="step-text">
            <span class="step-title">Add the Companion to Spec Kit</span>
            <span class="step-sub">One command. The same command updates it later.</span>
          </div>
          <CodeLine
            class="step-action"
            command={INSTALL_COMMAND}
            data-analytics="install_click_speckit_copy"
            data-analytics-placement="quick-start"
          />
        </div>
      </div>

      <a class="watch-link" href="/docs/start/getting-started/">
        <svg width="16" height="16" viewBox="0 0 26 26" fill="none" aria-hidden="true">
          <circle cx="13" cy="13" r="11" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M10.5 8.5L18 13L10.5 17.5V8.5Z" fill="currentColor"></path>
        </svg>
        <span>watch: your first spec, from Create Spec to the Overview →</span>
      </a>
    </div>
  </section>

  <!-- DEMO -->
  <section class="section section--demo">
    <div class="inner demo-stack" data-tabs>
      {/* The point arrives before the clip does. All four sit in one grid cell
          so the frame below never jumps when the copy swaps. */}
      <div class="demo-say">
        {
          tabs.map((tab, index) => (
            <div
              class="say"
              data-say={tab.id}
              data-active={index === 0 ? '' : undefined}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <h2>{tab.heading}</h2>
              <p>{tab.body}</p>
            </div>
          ))
        }
      </div>

      <div class="demo-frame" data-demo-frame>
        <img
          class="lightwell lightwell--section"
          src={lightwell.section}
          alt=""
          aria-hidden="true"
          width="2400"
          height="1360"
          loading="lazy"
        />
        <div class="demo-panel">
          <div class="window">
