      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      padding: var(--frame-pad);
      border-radius: inherit;
      /* Two arcs, not one, and each runs through several violets rather than a
         single hue: the rim reads as light bending round glass instead of a dot
         chasing the border. The far arc is the dimmer of the two, so there is a
         front and a back to the light. */
      background: conic-gradient(
        from var(--edge),
        var(--ground-a0) 0%,
        var(--accent-a50) 4%,
        var(--accent-hover) 9%,
        var(--on-accent) 13%,
        var(--accent) 18%,
        var(--accent-solid) 25%,
        var(--ground-a0) 36%,
        var(--ground-a0) 54%,
        var(--accent-solid) 62%,
        var(--accent) 70%,
        var(--accent-hover) 76%,
        var(--accent-a50) 82%,
        var(--ground-a0) 92%
      );
      -webkit-mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 300ms cubic-bezier(0.23, 1, 0.32, 1);
      pointer-events: none;
      /* Slow enough to read as a shine rather than a spinner. */
      animation: edge-travel 14s linear infinite;
    }

    /* The highlight lights with the panel and goes out with it, so an
       off-screen frame is never carrying a lit edge. */
    :global(html[data-motion]) .demo-frame[data-in]::after {
      opacity: 1;
    }

    /* The hero frame gets the same rim, a little quicker and a little dimmer,
       so the two read as the same material without competing. */
    :global(html[data-motion]) .hero-stagebox::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      padding: 1px;
      border-radius: inherit;
      background: conic-gradient(
        from var(--edge),
        var(--ground-a0) 0%,
        var(--accent-hover) 8%,
        var(--on-accent) 12%,
        var(--accent) 18%,
        var(--ground-a0) 32%,
        var(--ground-a0) 58%,
        var(--accent) 68%,
        var(--accent-hover) 74%,
        var(--ground-a0) 88%
      );
      -webkit-mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0.85;
      pointer-events: none;
      animation: edge-travel 11s linear infinite;
    }
