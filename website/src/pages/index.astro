<script>
  // Two small controllers, both crossfading with CSS transitions so a rapid
  // click retargets the fade instead of restarting it.

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // --- hero: three surfaces, one glowing centre ----------------------------
  // Chips drift in a field; the one you pick lights up, the centre flares, and
  // the shot resolves out of the glow. There is no window title and no standing
  // caption: the chip names it and its sentence surfaces for a beat.
  document.querySelectorAll('[data-hero-show]').forEach((root) => {
    const pips = Array.from(root.querySelectorAll('[data-hero-pip]'));
    const shots = Array.from(root.querySelectorAll('[data-hero-shot]'));
    const bloom = root.querySelector('[data-hero-bloom]');
    const flash = root.querySelector('[data-hero-flash]');
    if (pips.length < 2) return;

    const DWELL = 4600;
    const FLASH_HOLD = 2600;
    let index = 0;
    let timer = null;
    let flashTimer = null;
    let stopped = false;

    let flareTimer = null;
    const flare = () => {
      if (!bloom || reduced.matches) return;
      // The light lifts as the new surface arrives and settles back. Holding it
      // at full would brighten permanently after the first swap rather than
      // marking the swap at all.
      bloom.setAttribute('data-flare', '');
      if (flareTimer) window.clearTimeout(flareTimer);
      flareTimer = window.setTimeout(() => bloom.removeAttribute('data-flare'), 620);
    };

    const show = (next) => {
      index = (next + pips.length) % pips.length;
      const pip = pips[index];
      const id = pip.dataset.heroPip;

      pips.forEach((p, i) => {
        p.setAttribute('aria-selected', i === index ? 'true' : 'false');
        p.tabIndex = i === index ? 0 : -1;
      });
      shots.forEach((shot) => shot.toggleAttribute('data-active', shot.dataset.heroShot === id));

      flare();

      if (flash) {
        flash.textContent = pip.dataset.heroCaption || '';
        flash.setAttribute('data-show', '');
        if (flashTimer) window.clearTimeout(flashTimer);
        // Under reduced motion the sentence is the only thing carrying the
        // benefit, so it stays put instead of fading out.
        if (!reduced.matches) {
          flashTimer = window.setTimeout(() => flash.removeAttribute('data-show'), FLASH_HOLD);
        }
      }
    };

    const stop = () => {
      stopped = true;
      if (timer) window.clearInterval(timer);
      timer = null;
    };

    const start = () => {
      if (stopped || timer || reduced.matches) return;
      timer = window.setInterval(() => show(index + 1), DWELL);
    };

    const pause = () => {
      if (timer) window.clearInterval(timer);
      timer = null;
    };

    pips.forEach((pip, i) => {
      // A click is a choice. Honour it and get out of the way for good.
      pip.addEventListener('click', () => {
        stop();
        show(i);
      });
      pip.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        stop();
        show(i + step);
        pips[index].focus();
      });
    });

    // Hover and focus only hold it, so moving away picks the cycle back up.
    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', start);

    show(0);
    start();
  });

  // --- demo tabs -----------------------------------------------------------
  document.querySelectorAll('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll('[data-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-panel]'));
    const says = Array.from(root.querySelectorAll('[data-say]'));
    const label = root.querySelector('[data-window-label]');
    if (!tabs.length) return;

    // A clip is only worth playing once the viewer can see the whole frame.
    // Until then the poster stands in, so the opening hold every composition
    // now carries is actually the first thing anyone sees. `armed` flips once
    // and stays flipped: after the first arrival, a tab click plays at once.
    let armed = false;
    let current = tabs[0].dataset.tab;

    const activeVideo = () => {
      const panel = panels.find((p) => p.dataset.panel === current);
      return panel ? panel.querySelector('video') : null;
    };

    // Always from frame one. Resuming mid-tour is the same bug as starting
    // before arrival: the viewer sees a highlight with no idea what preceded it.
    // preload="none" means the element may never have fetched anything, and
    // raising preload alone does not start one: it needs an explicit load().
    const warmOne = (video) => {
      if (!video) return;
      if (video.preload !== 'auto') video.preload = 'auto';
      if (video.networkState === HTMLMediaElement.NETWORK_EMPTY) video.load();
    };

    const start = (video) => {
      if (!video || reduced.matches) return;
      warmOne(video);
      try {
        video.currentTime = 0;
      } catch {}
      video.play().catch(() => {});
    };

    const select = (id) => {
      current = id;

      tabs.forEach((tab) => {
        const on = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        if (on && label && tab.dataset.window) label.textContent = tab.dataset.window;
      });

      says.forEach((say) => {
        const on = say.dataset.say === id;
        say.toggleAttribute('data-active', on);
        say.setAttribute('aria-hidden', on ? 'false' : 'true');
      });

      panels.forEach((panel) => {
        const on = panel.dataset.panel === id;
        panel.toggleAttribute('data-active', on);
        panel.setAttribute('aria-hidden', on ? 'false' : 'true');

        const video = panel.querySelector('video');
        if (!video) return;
        // Reduced motion never plays. The poster is the whole experience.
        if (on && armed) start(video);
        else video.pause();
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.tab));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = tabs[(index + step + tabs.length) % tabs.length];
        select(next.dataset.tab);
        next.focus();
      });
    });

    select(tabs[0].dataset.tab);

    // data-tabs and data-demo-frame sit on the same element, so the frame is
    // the root; the query is only here if they ever come apart.
    const frame = root.matches('[data-demo-frame]')
      ? root
      : root.querySelector('[data-demo-frame]') || root;

    // preload="none" keeps the clips off the critical path, but it also means
    // nothing is buffered when the frame arrives and the opening hold would
    // stall exactly where it needs to be still. Fetch on approach instead.
    if ('IntersectionObserver' in window && !reduced.matches) {
      const warm = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          warm.disconnect();
          // Only the clip that is about to play. The other three stay unfetched
          // until someone actually picks their tab, which is the whole point of
          // preload="none".
          warmOne(activeVideo());
        },
        { rootMargin: '600px 0px' }
      );
      warm.observe(frame);

      // Fully in view, not merely intersecting. A frame taller than the
      // viewport can never reach ratio 0.9, so covering most of the screen
      // counts too.
      const seen = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const whole = entry.intersectionRatio >= 0.9;
            const fills = entry.intersectionRect.height >= window.innerHeight * 0.85;
            const video = activeVideo();
            if (entry.isIntersecting && (whole || fills)) {
              armed = true;
              // Paused means either never started or scrolled away from. Both
              // want the same thing: run it again from the opening hold.
              if (video && video.paused) start(video);
            } else if (!entry.isIntersecting && video) {
              video.pause();
            }
          }
        },
        { threshold: [0, 0.5, 0.9, 1] }
      );
      seen.observe(frame);
    } else {
      armed = true;
      start(activeVideo());
    }
  });

  // --- accordion -----------------------------------------------------------
  document.querySelectorAll('[data-accordion]').forEach((root) => {
    const section = root.closest('section');
    const rows = Array.from(root.querySelectorAll('[data-acc-row]'));
    const stills = section ? Array.from(section.querySelectorAll('[data-acc-still]')) : [];

    const open = (id) => {
      rows.forEach((row) => {
        const on = row.dataset.accRow === id;
        row.toggleAttribute('data-open', on);
        const toggle = row.querySelector('[data-acc-toggle]');
        if (toggle) toggle.setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      stills.forEach((still) => {
        still.toggleAttribute('data-active', still.dataset.accStill === id);
      });
    };

    rows.forEach((row) => {
      const toggle = row.querySelector('[data-acc-toggle]');
      if (!toggle) return;
      toggle.addEventListener('click', () => open(row.dataset.accRow));
    });
  });

  // --- motion --------------------------------------------------------------
  // The stylesheet gates every resting state on html[data-motion], so pulling
  // the attribute is all it takes to restore the static page. A visitor who
  // turns reduced motion on mid-visit gets that, live.
  const root = document.documentElement;
  const EASE = 'cubic-bezier(0.23, 1, 0.32, 1)';

  reduced.addEventListener('change', () => {
    if (reduced.matches) root.removeAttribute('data-motion');
  });

  if (root.hasAttribute('data-motion')) {
    // The page reads the scroller in exactly one place. Anything that needs
    // scroll position subscribes here and is called inside a single
    // requestAnimationFrame, so a fast flick coalesces into one frame of work
    // no matter how many things are listening. Same for resize: one debounced
    // listener, one list of things to re-measure.
    const scrollReaders = [];
    let scrollQueued = false;

    const onScroll = (read) => {
      scrollReaders.push(read);
      if (scrollReaders.length > 1) return;
      window.addEventListener(
        'scroll',
        () => {
          if (scrollQueued) return;
          scrollQueued = true;
          requestAnimationFrame(() => {
            scrollQueued = false;
            for (const fn of scrollReaders) fn();
          });
        },
        { passive: true }
      );
    };

    const resizeReaders = [];
    let resizeTimer = 0;

    const onResize = (measure) => {
      resizeReaders.push(measure);
      if (resizeReaders.length > 1) return;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          for (const fn of resizeReaders) fn();
        }, 150);
      });
    };

    // Entrances. Cards and accordion rows carry their own stagger delay, the
    // demo frame settles up out of its own glow, and a section's ambient light
    // grows in behind it. Each target is unobserved the moment it lands, so
    // nothing re-runs on the way back up.
    const entering = document.querySelectorAll('[data-reveal], [data-demo-frame]');
    if (entering.length) {
      const enter = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.setAttribute('data-in', '');
            enter.unobserve(entry.target);
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );
      entering.forEach((el) => enter.observe(el));
    }

    // The handoff. One particle leaves the mascot's line of flight, lands on
    // row 01, and row 02 lights 80ms behind it.
    const steps = document.querySelector('[data-steps]');
    const spark = steps ? steps.querySelector('[data-spark]') : null;
    const stepRows = steps ? Array.from(steps.querySelectorAll('[data-step]')) : [];

    if (steps && spark && stepRows.length && typeof spark.animate === 'function') {
      const handoff = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          handoff.disconnect();

          const box = steps.getBoundingClientRect();
          const num = stepRows[0].querySelector('.step-num');
          const target = num ? num.getBoundingClientRect() : box;
          const mascot = document.querySelector('[data-mascot]');
          const from = mascot ? mascot.getBoundingClientRect() : null;
          const endX = target.left - box.left + target.width / 2;
          const endY = target.top - box.top + target.height / 2;
          // The mascot can be most of a screen away by the time the row
          // lights. The particle keeps its horizontal line but starts at most
          // 220px up, so the drift still reads inside a 300ms move.
          const startX = from ? from.left + from.width / 2 - box.left : endX;
          const rise = from
            ? Math.min(220, Math.max(80, endY - (from.bottom - box.top)))
            : 160;

          spark.animate(
            [
              {
                transform: `translate3d(${startX}px, ${endY - rise}px, 0) scale(0.5)`,
                opacity: 0,
              },
              {
                transform: `translate3d(${(startX + endX) / 2}px, ${endY - rise * 0.4}px, 0) scale(1)`,
                opacity: 1,
                offset: 0.5,
              },
              { transform: `translate3d(${endX}px, ${endY}px, 0) scale(0.4)`, opacity: 0 },
            ],
            { duration: 900, easing: EASE, fill: 'forwards' }
          );

          window.setTimeout(() => stepRows[0].setAttribute('data-lit', ''), 760);
          window.setTimeout(() => {
            if (stepRows[1]) stepRows[1].setAttribute('data-lit', '');
          }, 1250);
        },
        { threshold: 0.35 }
      );

      handoff.observe(steps);
    }

    // The rim light used to be driven from here: its angle was scroll position,
    // so it stood still whenever the reader did. It runs off its own clock in
    // CSS now, which is both what light behind glass does and about sixty lines
    // less than measuring the frame and reading scrollY every frame.

    // The one number on the page counts up once, on first entry. The markup
    // already carries the final digits, so this only rewrites them.
    const claim = document.querySelector('[data-claim]');
    const figures = claim ? Array.from(claim.querySelectorAll('[data-count-to]')) : [];

    if (claim && figures.length) {
      const targets = figures.map((el) => Number(el.dataset.countTo));
      const counter = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          counter.disconnect();
          const started = performance.now();
          const tick = (now) => {
            const progress = Math.min(1, (now - started) / 300);
            figures.forEach((el, index) => {
              el.textContent = String(Math.round(targets[index] * progress));
            });
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        },
        { threshold: 0.5 }
      );
      counter.observe(claim);
    }

    // The closing glow swells with how much of the section is on screen,
    // normalised by the most that can ever be visible, so a section taller
    // than the viewport still reaches full strength.
    const cta = document.querySelector('[data-cta]');
    const ctaGlow = cta ? cta.querySelector('.cta-glow') : null;

    if (ctaGlow) {
      const swell = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const viewport = entry.rootBounds ? entry.rootBounds.height : window.innerHeight;
            const reach = Math.min(viewport, entry.boundingClientRect.height);
            const shown = reach > 0 ? entry.intersectionRect.height / reach : 0;
            ctaGlow.style.setProperty('--cta-glow', Math.min(1, shown).toFixed(3));
          });
        },
        { threshold: Array.from({ length: 21 }, (_, i) => i / 20) }
      );
      swell.observe(cta);
    }

    // The stem. The vine's height is scroll position and each leaf fills as
    // its section passes, so the page acts out a run completing phase by
    // phase. It is the only scroll-linked move here and the only one allowed
    // past 300ms.
    const stem = document.querySelector('[data-stem]');
    const vine = stem ? stem.querySelector('[data-stem-vine]') : null;
    const leaves = stem ? Array.from(stem.querySelectorAll('[data-stem-leaf]')) : [];
    // Where the browser can drive the animation off the scroller itself, it
    // does, and nothing at all runs on the scroll event.
    const scrollTimeline =
      typeof CSS !== 'undefined' &&
      typeof CSS.supports === 'function' &&
      CSS.supports('animation-timeline: scroll(root block)') &&
      CSS.supports('animation-range: 10% 20%');
    const wide = window.matchMedia('(min-width: 861px)');

    if (stem && vine && leaves.length) {
      let marks = [];

      const scrollSpan = () => document.documentElement.scrollHeight - window.innerHeight;

      const paint = () => {
        if (!wide.matches) return;
        const span = scrollSpan();
        const progress = span > 0 ? Math.min(1, Math.max(0, window.scrollY / span)) : 0;
        stem.style.setProperty('--stem-progress', progress.toFixed(4));
        marks.forEach((mark) => {
          mark.leaf.style.setProperty('--leaf-fill', progress >= mark.at ? '1' : '0');
        });
      };

      const measure = () => {
        const sections = Array.from(document.querySelectorAll('main .section'));
        const span = scrollSpan();
        if (span <= 0) {
          stem.removeAttribute('data-stem-ready');
          return;
        }

        marks = [];
        leaves.forEach((leaf, index) => {
          const section = sections[index];
          if (!section) {
            leaf.removeAttribute('data-placed');
            return;
          }
          // A boundary counts as passed when it reaches the middle of the
          // viewport, which is where the vine's tip sits at that moment.
          const top = section.getBoundingClientRect().top + window.scrollY;
          const at = Math.min(0.98, Math.max(0.02, (top - window.innerHeight / 2) / span));
          const percent = (at * 100).toFixed(2);
          marks.push({ leaf, at });
          leaf.style.setProperty('--leaf-at', `${percent}%`);
          leaf.style.setProperty('--leaf-from', `${percent}%`);
          leaf.style.setProperty('--leaf-to', `${Math.min(100, at * 100 + 5).toFixed(2)}%`);
          leaf.setAttribute('data-placed', '');
        });

        stem.setAttribute('data-stem-ready', '');
        if (!scrollTimeline) paint();
      };

      if (scrollTimeline) {
        stem.setAttribute('data-stem-mode', 'timeline');
      } else {
        onScroll(paint);
      }

      onResize(measure);

      measure();
      // Media that lands late changes the document height, so the marks are
      // taken once more after the page settles.
      window.addEventListener('load', () => measure(), { once: true });
    }
  }
</script>
