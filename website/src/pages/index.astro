  /* Both progress values interpolate, so they are registered. Where @property
     is missing they still substitute as plain numbers and the two moves step
     instead of easing. */
  @property --stem-progress {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  @property --leaf-fill {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  /* The angle the frame's highlight sits at. Registered so the scroll-driven
     path can interpolate it, and inherited so the fallback can set it on the
     frame and have the pseudo element pick it up. */
  @property --edge {
    syntax: '<angle>';
    inherits: true;
    initial-value: 0deg;
  }

  /* --- the stem: the one scroll-linked move ------------------------------ */

  .stem {
    position: fixed;
    top: 96px;
    bottom: 96px;
    left: 16px;
    z-index: 2;
    display: none;
    width: 18px;
    pointer-events: none;
  }

  .stem-rail,
  .stem-vine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 2px;
    width: 2px;
    border-radius: var(--radius-pill);
  }

  .stem-rail {
    background: var(--rule);
  }

  /* The vine is the light source, and its height is scroll position. At the
     top of the page it is scaled to nothing, so there is no halo at rest: the
     glow only exists while the line is being drawn. */
  .stem-vine {
    background: linear-gradient(180deg, var(--accent-a50), var(--accent) 60%, var(--green));
    filter: drop-shadow(0 0 5px var(--accent-a50));
    transform: scaleY(var(--stem-progress));
    transform-origin: top;
  }

  /* -6px centres the 13px leaf on its mark. It is a static offset, not a
     value anything animates. */
  .stem-leaf {
    position: absolute;
    top: var(--leaf-at, 0%);
    left: 1px;
    display: none;
    width: 14px;
    height: 13px;
    margin-top: -6px;
    transition: --leaf-fill 260ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .stem-leaf[data-placed] {
    display: block;
  }

  /* Unlit, the leaf is a bud: the same green outline held at a third. Lit, it
     fills in and reads as the leaf-as-checkmark, a short stalk into a long
     blade. Both states are the one colour at two strengths, so the fill can be
     driven by a single number with no colour interpolation. */
  .leaf-stalk,
  .leaf-blade {
    stroke: var(--green);
    stroke-opacity: calc(0.3 + 0.7 * var(--leaf-fill));
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .leaf-blade {
    fill: var(--green-leaf);
    fill-opacity: var(--leaf-fill);
    transform: scale(calc(0.6 + 0.4 * var(--leaf-fill)));
    transform-box: fill-box;
    transform-origin: 10% 95%;
  }

  @keyframes stem-grow {
    from {
      --stem-progress: 0;
    }
    to {
      --stem-progress: 1;
    }
  }

  @keyframes leaf-open {
    from {
      --leaf-fill: 0;
    }
    to {
      --leaf-fill: 1;
    }
  }

  /* Where the browser can drive an animation from the scroller itself, it
     does, and nothing runs on the scroll event. Elsewhere the script sets the
     same two properties from a throttled listener.

     animation-timeline is kept in its own rule on purpose: folded into the
     animation shorthand, the minifier emits a form browsers dropped from that
     shorthand, and the timeline silently reverts to auto. */
  @supports (animation-timeline: scroll()) {
    .stem[data-stem-mode='timeline'] .stem-vine {
      animation: stem-grow linear both;
    }

    .stem[data-stem-mode='timeline'] .stem-leaf {
      animation: leaf-open linear both;
      animation-range: var(--leaf-from) var(--leaf-to);
      transition: none;
    }

    .stem[data-stem-mode='timeline'] .stem-vine,
    .stem[data-stem-mode='timeline'] .stem-leaf {
      animation-timeline: scroll(root block);
    }
  }

  /* --- hero -------------------------------------------------------------- */

  @keyframes ink-in {
    from {
      opacity: 0;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* Last thing in the hero. The page has had time to settle before the word
     inks in, so it reads as an arrival rather than as part of the paint. */
  :global(html[data-motion]) h1 em {
    animation: ink-in 260ms cubic-bezier(0.23, 1, 0.32, 1) 700ms both;
  }

  @keyframes mascot-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -5px, 0);
    }
  }

  :global(html[data-motion]) .mascot {
    animation: mascot-drift 5200ms ease-in-out infinite;
  }

  /* --- spores: the one place a loop is the right answer ------------------ */

  /* A point of light rises, brightens, and goes out. Every point carries its
     own period and a negative delay from the markup, so the field is mid-drift
     on the first frame and no two are ever in step. The blur is what turns a
     dot into atmosphere; without it these read as confetti.

     Peak alpha is the keyframe's own value scaled by the point's --sb, so one
     field can hold near points and far ones. Both --sb and --sblur fall back,
     which is why a section that places neither is unaffected. */
  @keyframes spore-drift {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
    18% {
      opacity: calc(0.4 * var(--sb, 1));
    }
    50% {
      transform: translate3d(var(--sdx), var(--sdy), 0);
      opacity: calc(0.5 * var(--sb, 1));
    }
    82% {
      opacity: calc(0.26 * var(--sb, 1));
    }
    100% {
      transform: translate3d(calc(var(--sdx) * 0.25), calc(var(--sdy) * 2), 0);
      opacity: 0;
    }
  }

  :global(html[data-motion]) .spore {
    position: absolute;
    top: var(--sy);
    left: var(--sx);
    display: block;
    width: var(--ss);
    height: var(--ss);
    border-radius: 50%;
    background: var(--accent-hover);
    filter: blur(var(--sblur, 1.5px));
    opacity: 0;
    animation: spore-drift var(--sdur) linear var(--sdelay) infinite;
  }

  :global(html[data-motion]) .spore[data-tone='green'] {
    background: var(--green-leaf);
  }

  /* --- hero into quick start: the one orchestrated handoff --------------- */

  .spark {
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: var(--accent-hover);
    filter: drop-shadow(0 0 6px var(--accent-a50));
    opacity: 0;
    pointer-events: none;
  }

  /* The wash passes over the row's text rather than behind it, which is what
     light landing on a row looks like. At 14% for 300ms it tints, not hides. */
  .step-flare {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--accent-solid-a14), transparent 55%);
    opacity: 0;
    pointer-events: none;
  }

  @keyframes row-light {
    0% {
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  :global(html[data-motion]) .step[data-lit] .step-flare {
    animation: row-light 560ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  /* --- demo, cards, accordion, claim, footer ----------------------------- */

  /* Arrival is a focus pull, not a slide: a sixty-fourth off full size plus
     the fade, so the block reads as coming into focus. It settles once. The
     observer stops watching at that point, so scrolling back up re-runs
     nothing. */
  :global(html[data-motion]) .demo-frame {
    opacity: 0.4;
    transform: translate3d(0, 14px, 0) scale(0.985);
    transition:
      opacity 300ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(html[data-motion]) .demo-frame[data-in] {
    opacity: 1;
    transform: none;
  }

  :global(html[data-motion]) [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 12px, 0) scale(0.985);
    transition:
      opacity 220ms cubic-bezier(0.23, 1, 0.32, 1) var(--reveal-delay, 0ms),
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1) var(--reveal-delay, 0ms);
  }

  :global(html[data-motion]) [data-reveal][data-in] {
    opacity: 1;
    transform: none;
  }

  /* The ambient per-section wash that used to live here is gone.
     It was a 12%-alpha violet ellipse on four sections, added back when the page
     had no light in it at all. Its vertical reach ran past the section's own
     bottom edge, so it was still lit where the section ended and produced a hard
     horizontal seam at every boundary — most visibly between quick start and the
     demo. With the lightwell doing the real work, the wash was competing with it
     and paying for that competition in seams.

     Black between the two lit sections is the design, not an absence. */

  /* --- the light that walks the demo frame ------------------------------- */

  /* This used to be a readout of scroll position: one lap per pass of the
     section, so the highlight sat still whenever the reader did. It runs on its
     own clock now, because the frame is glass with light behind it and light
     behind glass does not stop when you stop.

     The ring is the frame's own 2px padding, cut out of a full-bleed conic
     gradient by a two-layer mask. Where that mask cannot be composited the rule
     never applies and the frame keeps the plain gradient border it ships with. */
  @keyframes edge-travel {
    from {
      --edge: 0deg;
    }
    to {
      --edge: 360deg;
    }
  }

