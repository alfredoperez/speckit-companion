---
/*
  Two variants: a filled purple primary and a bordered secondary.
  Three sizes, matching the three button footprints in the token sheet:
    lg   14px 26px, 9px radius   hero buttons
    cta  14px 28px, 9px radius   footer call to action
    md   11px 18px, 8px radius   Open in VS Code

  Renders an anchor when href is set, a button otherwise.
*/
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'lg' | 'cta' | 'md';
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'lg',
  type = 'button',
  external = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className];
const extra = href
  ? { href, ...(external ? { target: '_blank', rel: 'noreferrer noopener' } : {}) }
  : { type };
---

<Tag class:list={classes} {...extra} {...rest}><slot /></Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    border: 1px solid transparent;
    font-family: var(--font-mono);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 160ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 160ms cubic-bezier(0.23, 1, 0.32, 1),
      color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .btn--primary {
    background: var(--accent-solid);
    color: var(--on-accent);
    font-weight: var(--fw-medium);
  }

  .btn--primary:hover {
    background: var(--accent);
  }

  /* The sheet records a weight only for the filled labels, so the bordered one
     stays at the regular weight. */
  .btn--secondary {
    background: transparent;
    border-color: var(--border-strong);
    color: var(--text-primary);
    font-weight: var(--fw-regular);
  }

  .btn--secondary:hover {
    border-color: var(--border-accent-strong);
    color: var(--text-primary);
  }

  .btn--lg {
    padding: 14px 26px;
    border-radius: var(--radius-button);
    font-size: var(--fs-ui);
  }

  .btn--cta {
    padding: 14px 28px;
    border-radius: var(--radius-button);
    font-size: var(--fs-ui);
  }

  .btn--md {
    padding: 11px 18px;
    border-radius: var(--radius-button-sm);
    font-size: var(--fs-ui-sm);
  }
</style>
