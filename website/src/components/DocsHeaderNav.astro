---
import StarlightSocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import SoonChip from './SoonChip.astro';
import { INSTALL_HREF, isCurrentPath, navGroups } from './navLinks';

/*
  Starlight's header has no slot for product links, so this component stands in
  for SocialIcons, which is the one piece of the header that renders both in the
  desktop bar and in the mobile menu.

  It reads the same ./navLinks.ts the landing-page nav does, so the two halves of
  the site show one bar in one order: docs, the unshipped pair, changelog, then
  install. Starlight's own social links render after it, unchanged.
*/
const here = Astro.url.pathname;
---

<nav class="docs-nav" aria-label="Site">
  <ul>
    {
      navGroups.map((group) => (
        <li class:list={['group', group.length > 1 && 'is-pair']}>
          {group.map((link) => (
            <span class="item">
              <a href={link.href} aria-current={isCurrentPath(here, link.href) ? 'page' : undefined}>
                {link.label}
              </a>
              {link.soon && <SoonChip />}
            </span>
          ))}
        </li>
      ))
    }
    <li class="group">
      <a class="install" href={INSTALL_HREF}>install</a>
    </li>
  </ul>
</nav>

<StarlightSocialIcons />

<style>
  .docs-nav {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-22);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group {
    display: inline-flex;
    align-items: center;
  }

  /* The unshipped pair sits tighter than the gap between groups, the same
     14px against 22px the landing-page nav uses. */
  .group.is-pair {
    gap: var(--space-14);
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
  }

  a {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--text-primary);
  }

  /* 7px is the install button's own radius on the landing page, kept in step
     here so the same control reads the same in both halves. */
  .install {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    color: var(--accent-hover);
    transition: border-color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .install:hover {
    border-color: var(--border-accent-strong);
    color: var(--accent-hover);
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Starlight's header keeps the right group on one line from 50rem up. Below
     that this renders inside the mobile menu, where wrapping is the point. */
  @media (max-width: 72rem) {
    ul {
      gap: var(--space-16);
    }
  }
</style>
