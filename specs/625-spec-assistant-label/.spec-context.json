  "intent": "Show which assistant a spec was dispatched to and let the developer reveal its terminal",
  "decisions": [
    {
      "decision": "Store the provider id in an additive assistant field, written after the run resolves",
      "why": "Stable, re-resolved through an allow-list on read, and a failed dispatch records nothing",
      "rejected": "Memory only, or storing the display name"
    },
    {
      "decision": "One resolver, resolveSpecAssistant, feeds the sidebar row and the viewer navState",
      "why": "The webview cannot re-derive the name, so the two cannot disagree",
      "rejected": "The in PROVIDER_PATHS check, which accepts prototype keys"
    },
    {
      "decision": "A separate specTerminals registry keyed by spec directory",
      "why": "terminalStepTracker completes a step on close and skips some steps",
      "rejected": "A reverse lookup inside terminalStepTracker"
    },
    {
      "decision": "Gate the row action with a +terminal contextValue suffix",
      "why": "viewItem is the only per-row gate and manifest.test pins every clause",
      "rejected": "A global any-terminal key or a selection key"
    },
    {
      "decision": "Note the dispatch inside dispatchStep with a duck-typed terminal check",
      "why": "One seam covers the sidebar and the viewer, and dispatchStep is generic over what run returns",
      "rejected": "Each caller registering its own terminal"
    },
    {
      "decision": "Pass the +terminal suffix through the row constructor",
      "why": "contextValue is read-only on the item and isSpecLifecycleItem strips the suffix",
      "rejected": "Mutating the item after construction"
    }
  ],
