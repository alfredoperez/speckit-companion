{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist/webview",
    // Rooted at the repo so the webview can import the protocol and the
    // `.spec-context.json` contract from `src/` instead of re-declaring them.
    // Nothing is emitted from here — webpack bundles this project — so widening
    // the root changes no output path.
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "moduleResolution": "bundler",
    "removeComments": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "webview/src/**/*",
    "src/protocol/**/*",
    "src/core/types/**/*",
    "src/core/utils/dispatcher.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.tsx",
    "**/__stories__/**",
    "**/__fixtures__/**"
  ]
}
